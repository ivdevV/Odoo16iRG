<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_payment_date" model="ir.ui.view">
        <field name="name">account.move.form.payment.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="payment_date" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund'))]}"/>
            </xpath>
        </field>
    </record>
</odoo>
