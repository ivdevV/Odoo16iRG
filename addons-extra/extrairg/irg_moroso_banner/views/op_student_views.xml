<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_student_form_moroso_banner" model="ir.ui.view">
        <field name="name">op.student.form.moroso.banner</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/field[@name='active']/following-sibling::widget[@name='web_ribbon'][1]" position="after">
                <field name="irg_is_moroso" invisible="1"/>
                <widget name="web_ribbon" title="Moroso" bg_color="irg_bg_moroso"
                        attrs="{'invisible': [('irg_is_moroso', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
