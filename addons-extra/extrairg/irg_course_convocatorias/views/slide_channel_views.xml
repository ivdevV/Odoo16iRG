<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit slide.channel form: add HomeClass and Online tabs -->
    <record id="view_slide_channel_form_convocatorias" model="ir.ui.view">
        <field name="name">slide.channel.form.convocatorias.irg</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet" position="inside">
                <field name="irg_has_homeclass" invisible="1"/>
                <field name="irg_has_online" invisible="1"/>
            </xpath>

            <!-- Tab HomeClass: listed after "Secciones iRG" -->
            <xpath expr="//notebook/page[@name='irg_sections']" position="after">

                <page string="HomeClass" name="irg_homeclass_convocatorias" attrs="{'invisible': [('irg_has_homeclass', '=', False)]}">
                    <group>
                        <group string="Base académica">
                            <field name="irg_related_course_ids" widget="many2many_tags" readonly="1"/>
                            <field name="irg_related_modality_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <field name="irg_homeclass_batch_ids" readonly="1">
                        <tree create="0" delete="0" edit="0">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="academic_year"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="modality_id"/>
                            <field name="course_id" optional="show"/>
                        </tree>
                        <form>
                            <group>
                                <field name="code" readonly="1"/>
                                <field name="name" readonly="1"/>
                                <field name="academic_year" readonly="1"/>
                                <field name="start_date" readonly="1"/>
                                <field name="end_date" readonly="1"/>
                                <field name="modality_id" readonly="1"/>
                                <field name="course_id" readonly="1"/>
                            </group>
                        </form>
                    </field>
                    <group string="Secciones HomeClass">
                        <field name="irg_homeclass_section_ids" readonly="1">
                            <tree create="0" delete="0" edit="0">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="allowed_batch_ids" widget="many2many_tags"/>
                                <field name="scheduled_date"/>
                                <field name="is_published"/>
                            </tree>
                            <form>
                                <group>
                                    <field name="name" readonly="1"/>
                                    <field name="channel_id" readonly="1"/>
                                    <field name="allowed_batch_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="scheduled_date" readonly="1"/>
                                    <field name="is_published" readonly="1"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </page>

                <!-- Tab Online -->
                <page string="Online" name="irg_online_convocatorias" attrs="{'invisible': [('irg_has_online', '=', False)]}">
                    <group>
                        <group string="Base académica">
                            <field name="irg_related_course_ids" widget="many2many_tags" readonly="1"/>
                            <field name="irg_related_modality_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group string="Vinculación online">
                            <field name="irg_online_variant_id" readonly="1" options="{'no_open': True}"/>
                        </group>
                    </group>
                    <field name="irg_online_batch_ids" readonly="1">
                        <tree create="0" delete="0" edit="0">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="academic_year"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="modality_id"/>
                            <field name="course_id" optional="show"/>
                        </tree>
                        <form>
                            <group>
                                <field name="code" readonly="1"/>
                                <field name="name" readonly="1"/>
                                <field name="academic_year" readonly="1"/>
                                <field name="start_date" readonly="1"/>
                                <field name="end_date" readonly="1"/>
                                <field name="modality_id" readonly="1"/>
                                <field name="course_id" readonly="1"/>
                            </group>
                        </form>
                    </field>
                </page>

            </xpath>

        </field>
    </record>

</odoo>
