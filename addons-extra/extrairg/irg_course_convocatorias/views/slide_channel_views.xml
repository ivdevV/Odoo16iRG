<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit slide.channel form: add HomeClass and Online tabs -->
    <record id="view_slide_channel_form_convocatorias" model="ir.ui.view">
        <field name="name">slide.channel.form.convocatorias.irg</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="arch" type="xml">

            <!-- Tab HomeClass: listed after "Secciones iRG" -->
            <xpath expr="//notebook/page[@name='irg_sections']" position="after">

                <page string="HomeClass" name="irg_homeclass_convocatorias">
                    <field name="irg_homeclass_conv_ids"
                           context="{'default_channel_id': active_id, 'default_modality': 'homeclass'}">
                        <tree>
                            <control>
                                <create string="Nueva convocatoria HomeClass"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="year"/>
                            <field name="batch_ids" widget="many2many_tags" optional="show"/>
                            <field name="section_count" string="Secciones"/>
                        </tree>
                        <form>
                            <group>
                                <group string="Información general">
                                    <field name="name"/>
                                    <field name="modality" readonly="1"/>
                                    <field name="year"/>
                                    <field name="sequence"/>
                                </group>
                                <group string="Lotes asociados">
                                    <field name="batch_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           nolabel="1"/>
                                </group>
                            </group>
                            <notebook>
                                <page string="Secciones" name="sections">
                                    <field name="irg_section_ids"
                                           context="{'default_convocatoria_id': active_id, 'default_channel_id': parent.id}">
                                        <tree>
                                            <control>
                                                <create string="Añadir sección"/>
                                            </control>
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="slide_count" string="Contenidos"/>
                                            <field name="active" optional="hide"/>
                                        </tree>
                                        <form>
                                            <group>
                                                <field name="name"/>
                                                <field name="channel_id" readonly="1"/>
                                                <field name="convocatoria_id" readonly="1"/>
                                                <field name="sequence"/>
                                            </group>
                                        </form>
                                    </field>
                                </page>
                            </notebook>
                        </form>
                    </field>
                </page>

                <!-- Tab Online -->
                <page string="Online" name="irg_online_convocatorias">
                    <field name="irg_online_conv_ids"
                           context="{'default_channel_id': active_id, 'default_modality': 'online'}">
                        <tree>
                            <control>
                                <create string="Nueva convocatoria Online"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="year"/>
                            <field name="online_variant_id"/>
                            <field name="batch_ids" widget="many2many_tags" optional="show"/>
                            <field name="section_count" string="Secciones"/>
                        </tree>
                        <form>
                            <group>
                                <group string="Información general">
                                    <field name="name"/>
                                    <field name="modality" readonly="1"/>
                                    <field name="year"/>
                                    <field name="sequence"/>
                                </group>
                                <group string="Configuración Online">
                                    <field name="online_variant_id"
                                           options="{'no_create': True}"/>
                                    <field name="batch_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           nolabel="1"/>
                                </group>
                            </group>
                            <notebook>
                                <page string="Secciones" name="sections">
                                    <field name="irg_section_ids"
                                           context="{'default_convocatoria_id': active_id, 'default_channel_id': parent.id}">
                                        <tree>
                                            <control>
                                                <create string="Añadir sección"/>
                                            </control>
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="slide_count" string="Contenidos"/>
                                            <field name="active" optional="hide"/>
                                        </tree>
                                        <form>
                                            <group>
                                                <field name="name"/>
                                                <field name="channel_id" readonly="1"/>
                                                <field name="convocatoria_id" readonly="1"/>
                                                <field name="sequence"/>
                                            </group>
                                        </form>
                                    </field>
                                </page>
                            </notebook>
                        </form>
                    </field>
                </page>

            </xpath>

        </field>
    </record>

</odoo>
