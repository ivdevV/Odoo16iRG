<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_survey_exam_scale_100" model="ir.ui.view">
        <field name="name">survey.survey.form.exam.scale.100</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="priority">190</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="exam_scale_100" string="Escala Examen 100"
                      attrs="{'invisible': [('survey_type', 'not in', ['exam', 'cert'])]}">
                    <group>
                        <group>
                            <field name="x_exam_auto_scale_100" widget="boolean_toggle"/>
                            <field name="x_exam_equal_weight" widget="boolean_toggle"
                                   attrs="{'invisible': [('x_exam_auto_scale_100', '=', False)]}"/>
                            <field name="x_exam_target_score"
                                   attrs="{'invisible': [('x_exam_auto_scale_100', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="x_exam_scored_question_count" readonly="1"/>
                            <field name="x_exam_points_per_question" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_recalculate_exam_scale_100"
                                string="Recalcular Puntajes a 100"
                                type="object"
                                class="btn-primary"
                                attrs="{'invisible': ['|', ('x_exam_auto_scale_100', '=', False), ('x_exam_equal_weight', '=', False)]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
