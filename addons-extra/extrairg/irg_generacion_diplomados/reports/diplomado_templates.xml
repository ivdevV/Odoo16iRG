<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_diplomado_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <style>
                        @page {
                            size: A4 landscape;
                            margin: 0 !important;
                        }
                        html, body, body.container, #wrapwrap, main, .article {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 297mm !important;
                            max-width: 297mm !important;
                            min-width: 297mm !important;
                            background-color: transparent !important;
                            border: none !important;
                        }
                        body {
                            font-family: 'Helvetica', 'Arial', sans-serif;
                            -webkit-print-color-adjust: exact;
                            background-color: #ffffff !important;
                        }
                        .page-container {
                            position: relative;
                            width: 297mm;
                            height: 210mm;
                            margin: 0;
                            padding: 0;
                            page-break-after: always;
                            overflow: hidden;
                            box-sizing: border-box;
                        }
                        .page-container-back {
                            position: relative;
                            width: 297mm;
                            height: 210mm;
                            margin: 0;
                            padding: 0;
                            page-break-after: avoid;
                            overflow: hidden;
                            box-sizing: border-box;
                        }
                        .bg-image {
                            position: absolute;
                            top: 0;
                            left: 0;
                            width: 297mm;
                            height: 210mm;
                            z-index: -10;
                            display: block;
                        }
                        .top-logo {
                            position: absolute;
                            left: 106mm;
                            top: 8mm;
                            width: 85mm;
                            height: auto;
                            z-index: 10;
                        }
                        .center-text {
                            position: absolute;
                            left: 0;
                            width: 297mm;
                            text-align: center;
                        }
                        .signature-container-left {
                            position: absolute;
                            left: 35mm;
                            width: 80mm;
                            top: 176.8mm;
                            text-align: center;
                            font-size: 10pt;
                            line-height: 1.3;
                        }
                        .signature-container-right {
                            position: absolute;
                            left: 182mm;
                            width: 80mm;
                            top: 176.8mm;
                            text-align: center;
                            font-size: 10pt;
                            line-height: 1.3;
                        }
                        .signature-img-left {
                            position: absolute;
                            left: 56mm;
                            top: 139.2mm;
                            width: 37mm;
                            height: 36mm;
                            z-index: 5;
                        }
                        .signature-img-right {
                            position: absolute;
                            left: 185mm;
                            top: 138.0mm;
                            width: 45mm;
                            height: auto;
                            z-index: 5;
                        }
                    </style>

                    <!-- Página 1: Anverso del Diploma -->
                    <div class="page-container">
                        <!-- Fondo a hoja completa (Full Bleed) -->
                        <img class="bg-image" src="/irg_generacion_diplomados/static/src/img/diploma_background.jpg"/>
                        
                        <!-- Logo Superior -->
                        <img class="top-logo" src="/irg_generacion_diplomados/static/src/img/logo_instituto.jpg"/>

                        <!-- El instituto Raimon Gaja -->
                        <div class="center-text" style="top: 40.1mm; font-size: 17pt; font-weight: bold; color: #235F94; text-transform: none;">
                            El instituto Raimon Gaja
                        </div>

                        <!-- Hace constar que -->
                        <div class="center-text" style="top: 49.5mm; font-size: 12pt; color: #727F77; font-style: italic;">
                            Hace constar que
                        </div>

                        <!-- Nombre del Alumno -->
                        <div class="center-text" style="top: 57.5mm; font-size: 24pt; font-weight: bold; color: #000; letter-spacing: 1px;">
                            <span t-field="o.student_name"/>
                        </div>

                        <!-- Texto de Aprobación -->
                        <div class="center-text" style="left: 30mm; width: 237mm; top: 73.0mm; font-size: 11.5pt; color: #6C7A71; line-height: 1.5; font-family: 'Helvetica', 'Arial', sans-serif;">
                            ha aprobado los estudios correspondientes al programa de contenidos que figura en el dorso, celebrado del 
                            <strong><span t-field="o.start_date" t-options='{"widget": "date", "format": "d/MM/yyyy"}'/></strong> al 
                            <strong><span t-field="o.end_date" t-options='{"widget": "date", "format": "d/MM/yyyy"}'/></strong>, con una duración de 
                            <strong><span t-field="o.duration_hours"/> horas</strong>
                            <t t-if="o.duration_ects">
                                (equivalente a <strong><span t-field="o.duration_ects"/> ECTS</strong>)
                            </t>, por lo que se expide el presente diploma:
                        </div>

                        <!-- Nombre del Diplomado -->
                        <div class="center-text" style="top: 94.2mm; font-size: 18pt; font-weight: bold; color: #000; text-transform: uppercase; letter-spacing: 1px;">
                            <span t-field="o.diplomado_name"/>
                        </div>

                        <!-- que acredita haber superado con aprovechamiento... -->
                        <div class="center-text" style="top: 107.1mm; font-size: 11.5pt; color: #6C7A71; font-style: italic;">
                            que acredita haber superado con aprovechamiento las mencionadas enseñanzas.
                        </div>

                        <!-- Barcelona, a ... -->
                        <div class="center-text" style="top: 119.3mm; font-size: 11.5pt; color: #6C7A71;">
                            Barcelona, a <span t-field="o.issue_date" t-options='{"widget": "date", "format": "d/MM/yyyy"}'/>
                        </div>

                        <!-- Firmas e Imágenes -->
                        <img class="signature-img-left" src="/irg_generacion_diplomados/static/src/img/firma_izquierda.jpg"/>
                        <img class="signature-img-right" src="/irg_generacion_diplomados/static/src/img/firma_derecha.jpg"/>

                        <div class="signature-container-left">
                            <strong>Raimon Gaja Jaumeandreu</strong><br/>
                            <span style="color: #666; font-size: 9pt;">Director General iRG</span>
                        </div>

                        <div class="signature-container-right">
                            <strong>Fermín Carrillo González</strong><br/>
                            <span style="color: #666; font-size: 9pt;">Director de Relaciones Internacionales</span>
                        </div>
                    </div>

                    <!-- Página 2: Reverso del Diploma (Desglose de asignaturas) -->
                    <div class="page-container-back">
                        <!-- Fondo a hoja completa (Full Bleed) -->
                        <img class="bg-image" src="/irg_generacion_diplomados/static/src/img/diploma_background.jpg"/>
                        
                        <!-- Logo Superior -->
                        <img class="top-logo" src="/irg_generacion_diplomados/static/src/img/logo_instituto.jpg"/>

                        <!-- Módulos Presenciales Header -->
                        <div class="center-text" style="top: 41.2mm; font-size: 13pt; font-weight: bold; color: #033DAA; text-transform: uppercase; letter-spacing: 1px;">
                            Módulos Presenciales
                        </div>

                        <!-- Módulos Presenciales List -->
                        <div class="center-text" style="left: 30mm; width: 237mm; top: 53.0mm; font-size: 12pt; color: #333; line-height: 1.6; white-space: pre-line;">
                            <t t-if="o.subjects_presencial">
                                <span t-field="o.subjects_presencial"/>
                            </t>
                            <t t-else="">
                                <span class="text-muted" style="font-style: italic;">No se registran módulos en modalidad presencial.</span>
                            </t>
                        </div>

                        <!-- Módulos Online Header -->
                        <div class="center-text" style="top: 151.6mm; font-size: 13pt; font-weight: bold; color: #033DAA; text-transform: uppercase; letter-spacing: 1px;">
                            Módulos Online
                        </div>

                        <!-- Módulos Online List -->
                        <div class="center-text" style="left: 30mm; width: 237mm; top: 162.3mm; font-size: 12pt; color: #333; line-height: 1.6; white-space: pre-line;">
                            <t t-if="o.subjects_online">
                                <span t-field="o.subjects_online"/>
                            </t>
                            <t t-else="">
                                <span class="text-muted" style="font-style: italic;">No se registran módulos en modalidad online / virtual.</span>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
