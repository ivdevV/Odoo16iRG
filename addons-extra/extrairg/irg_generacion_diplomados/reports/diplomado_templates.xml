<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_diplomado_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <style>
                        .diploma-page {
                            position: relative;
                            width: 297mm;
                            height: 209mm;
                            box-sizing: border-box;
                            padding: 20mm;
                            page-break-after: always;
                            font-family: 'Helvetica', 'Arial', sans-serif;
                        }
                        .diploma-back-page {
                            position: relative;
                            width: 297mm;
                            height: 209mm;
                            box-sizing: border-box;
                            padding: 20mm;
                            font-family: 'Helvetica', 'Arial', sans-serif;
                        }
                        .diploma-title {
                            font-size: 32px;
                            font-weight: bold;
                            text-align: center;
                            margin-top: 30px;
                        }
                        .student-name {
                            font-size: 28px;
                            font-weight: bold;
                            text-align: center;
                            margin-top: 20px;
                        }
                        .details-text {
                            font-size: 16px;
                            text-align: center;
                            margin-top: 15px;
                            line-height: 1.5;
                        }
                        .subjects-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 12px;
                            margin-top: 10px;
                        }
                        .subjects-table th, .subjects-table td {
                            border: 1px solid #ddd;
                            padding: 6px 10px;
                            text-align: left;
                        }
                        .subjects-table th {
                            background-color: #f8f9fa;
                            font-weight: bold;
                        }
                        .column-half {
                            width: 48%;
                            float: left;
                            box-sizing: border-box;
                        }
                        .column-spacer {
                            width: 4%;
                            float: left;
                            height: 10px;
                        }
                        .clearfix::after {
                            content: "";
                            clear: both;
                            display: table;
                        }
                        .direction-seal {
                            margin-top: 40px;
                            text-align: center;
                            font-size: 14px;
                            position: absolute;
                            bottom: 20mm;
                            width: 100%;
                            left: 0;
                            padding: 0 20mm;
                            box-sizing: border-box;
                        }
                    </style>

                    <!-- Página 1: Anverso del Diploma -->
                    <div class="diploma-page">
                        <t t-if="o.diploma_type == 'digital'">
                            <!-- Marco decorativo solo para el diploma digital -->
                            <div style="position: absolute; top: 10mm; left: 10mm; right: 10mm; bottom: 10mm; border: 4px double #8B0000; pointer-events: none;"/>
                            <div style="position: absolute; top: 12mm; left: 12mm; right: 12mm; bottom: 12mm; border: 1px solid #8B0000; pointer-events: none;"/>
                        </t>
                        
                        <div style="text-align: center; margin-top: 15px;">
                            <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 70px;" alt="Logo"/>
                        </div>
                        
                        <div class="diploma-title" style="color: #4A4A4A; text-transform: uppercase; letter-spacing: 2px;">
                            Diploma de Especialización
                        </div>
                        
                        <div class="details-text" style="color: #666; font-style: italic;">
                            El Instituto Raimon Gaja certifica que:
                        </div>
                        
                        <div class="student-name" style="color: #8B0000; font-size: 34px; margin-top: 10px; letter-spacing: 1px;">
                            <span t-field="o.student_name"/>
                        </div>
                        
                        <div class="details-text" style="color: #666;">
                            ha cursado y superado satisfactoriamente los estudios correspondientes al Diplomado en:
                        </div>
                        
                        <div class="diploma-title" style="font-size: 26px; color: #111; margin-top: 5px; text-transform: uppercase;">
                            <span t-field="o.diplomado_name"/>
                        </div>
                        
                        <div class="details-text" style="margin-top: 15px; font-size: 15px;">
                            Estudios realizados desde el 
                            <strong><span t-field="o.start_date" t-options='{"widget": "date", "format": "d/MM/yyyy"}'/></strong> 
                            hasta el 
                            <strong><span t-field="o.end_date" t-options='{"widget": "date", "format": "d/MM/yyyy"}'/></strong>.
                        </div>
                        
                        <div class="details-text" style="margin-top: 10px; font-size: 15px;">
                            Con una carga académica de 
                            <strong><span t-field="o.duration_hours"/> horas</strong>
                            <t t-if="o.duration_ects">
                                equivalentes a <strong><span t-field="o.duration_ects"/> ECTS</strong>
                            </t>.
                        </div>
                        
                        <!-- Pie de página con firmas y registro -->
                        <div class="direction-seal">
                            <div class="clearfix" style="width: 100%;">
                                <div style="float: left; width: 35%; text-align: left;">
                                    <strong>Registro Nº:</strong> <span t-field="o.name"/><br/>
                                    <strong>Fecha de expedición:</strong> <span t-field="o.issue_date" t-options='{"widget": "date", "format": "d/MM/yyyy"}'/>
                                </div>
                                <div style="float: left; width: 30%; text-align: center; height: 50px;">
                                    <!-- Espacio para sello -->
                                </div>
                                <div style="float: right; width: 35%; text-align: right; margin-top: 10px;">
                                    <strong>Firma de la Dirección</strong>
                                    <div style="margin-top: 25px; border-top: 1px solid #8B0000; width: 200px; float: right;"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Página 2: Reverso del Diploma (Desglose de asignaturas) -->
                    <div class="diploma-back-page">
                        <t t-if="o.diploma_type == 'digital'">
                            <div style="position: absolute; top: 10mm; left: 10mm; right: 10mm; bottom: 10mm; border: 1px solid #ccc; pointer-events: none;"/>
                        </t>
                        
                        <div class="diploma-title" style="font-size: 22px; text-transform: uppercase; margin-top: 10px; color: #4A4A4A; border-bottom: 1px solid #ccc; padding-bottom: 10px;">
                            Anexo Académico - Programa de Asignaturas
                        </div>
                        
                        <div class="details-text" style="font-size: 13px; text-align: left; margin-top: 10px; margin-bottom: 25px; color: #555;">
                            Certificación de las materias y asignaturas cursadas por el alumno <strong><span t-field="o.student_name"/></strong> en el diplomado <strong><span t-field="o.diplomado_name"/></strong>:
                        </div>

                        <div class="clearfix" style="width: 100%;">
                            <!-- Columna de Módulos Presenciales -->
                            <div class="column-half">
                                <h5 style="border-bottom: 2px solid #8B0000; padding-bottom: 5px; color: #8B0000; font-weight: bold; font-size: 14px;">
                                    Módulos Presenciales
                                </h5>
                                <t t-if="o.subjects_presencial">
                                    <div style="white-space: pre-line; text-align: left; font-size: 12px; line-height: 1.6; color: #333; margin-top: 10px;">
                                        <span t-field="o.subjects_presencial"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <p class="text-muted" style="font-size: 12px; font-style: italic; margin-top: 10px;">
                                        No se registran módulos en modalidad presencial.
                                    </p>
                                </t>
                            </div>

                            <!-- Espacio central entre columnas -->
                            <div class="column-spacer"/>

                            <!-- Columna de Módulos Online -->
                            <div class="column-half">
                                <h5 style="border-bottom: 2px solid #00008B; padding-bottom: 5px; color: #00008B; font-weight: bold; font-size: 14px;">
                                    Módulos Online / Virtuales
                                </h5>
                                <t t-if="o.subjects_online">
                                    <div style="white-space: pre-line; text-align: left; font-size: 12px; line-height: 1.6; color: #333; margin-top: 10px;">
                                        <span t-field="o.subjects_online"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <p class="text-muted" style="font-size: 12px; font-style: italic; margin-top: 10px;">
                                        No se registran módulos en modalidad online / virtual.
                                    </p>
                                </t>
                            </div>
                        </div>
                        
                        <!-- Pie del reverso -->
                        <div style="position: absolute; bottom: 20mm; width: 100%; left: 0; padding: 0 20mm; box-sizing: border-box; font-size: 11px; color: #777; border-top: 1px solid #eee; padding-top: 10px; margin-top: 30px;">
                            <div class="clearfix">
                                <div style="float: left; width: 50%;">
                                    Documento emitido de forma automatizada por el registro histórico de diplomados.
                                </div>
                                <div style="float: right; width: 50%; text-align: right;">
                                    <strong>ID Registro:</strong> <span t-field="o.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
