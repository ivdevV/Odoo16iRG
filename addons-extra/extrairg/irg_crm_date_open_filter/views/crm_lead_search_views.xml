<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_case_tree_view_leads_date_open" model="ir.ui.view">
        <field name="name">crm.lead.tree.lead.irg.fecha.reactivacion</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_date']" position="after">
                <field name="irg_fecha_reactivacion" optional="hide"/>
                <field name="irg_campana_reactivacion" optional="hide"/>
                <field name="irg_fuente_reactivacion" optional="hide"/>
                <field name="irg_referido_reactivacion" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="crm_case_tree_view_oppor_date_open" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunity.irg.fecha.reactivacion.inactive</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_date']" position="after">
                <field name="irg_fecha_reactivacion" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_leads_filter_date_open" model="ir.ui.view">
        <field name="name">crm.lead.search.lead.irg.fecha.reactivacion</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_date']" position="after">
                <field name="irg_fecha_reactivacion"/>
                <field name="irg_campana_reactivacion"/>
                <field name="irg_fuente_reactivacion"/>
                <field name="irg_referido_reactivacion"/>
            </xpath>
            <xpath expr="//filter[@name='filter_creation_date']" position="after">
                <filter string="Fecha de Reactivación" name="filter_irg_fecha_reactivacion" date="irg_fecha_reactivacion"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_opportunities_filter_date_open" model="ir.ui.view">
        <field name="name">crm.lead.search.opportunity.irg.fecha.reactivacion</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_state']" position="after">
                <field name="irg_fecha_reactivacion"/>
                <field name="irg_campana_reactivacion"/>
                <field name="irg_fuente_reactivacion"/>
                <field name="irg_referido_reactivacion"/>
            </xpath>
            <xpath expr="//filter[@name='creation_date']" position="after">
                <filter string="Fecha de Reactivación" name="filter_irg_fecha_reactivacion" date="irg_fecha_reactivacion"/>
            </xpath>
        </field>
    </record>
</odoo>