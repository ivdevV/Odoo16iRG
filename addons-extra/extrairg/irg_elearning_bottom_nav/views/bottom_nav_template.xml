<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        IRG eLearning - Botones de navegación al pie del contenido
        
        Duplica los botones "Anterior" y "Siguiente" debajo del contenido de la
        unidad (slide_content_detailed) para que el alumno no tenga que subir
        hasta arriba al terminar de leer.
    -->
    <template id="slide_content_detailed_bottom_nav"
              name="IRG eLearning - Nav inferior Anterior/Siguiente"
              inherit_id="website_slides.slide_content_detailed"
              priority="90">

        <!-- Insertar botones después del bloque de contenido principal (t-else) -->
        <!-- Apuntamos solo al div con t-else para no romper el par t-if/t-else -->
        <xpath expr="//div[@t-else='' and hasclass('o_wslides_lesson_content_type')]" position="after">
            <div class="irg-slide-bottom-nav d-flex justify-content-between align-items-center mt-4 mb-3 pt-3 border-top">
                <a t-attf-class="btn btn-outline-secondary #{'disabled' if not previous_slide else ''}"
                   role="button"
                   t-att-aria-disabled="'disabled' if not previous_slide else None"
                   t-att-href="'/slides/slide/%s' % (slug(previous_slide)) if previous_slide else '#'">
                    <i class="fa fa-chevron-left me-2"/>Anterior
                </a>
                <a t-attf-class="btn btn-primary #{'disabled' if not next_slide else ''}"
                   role="button"
                   t-att-aria-disabled="'disabled' if not next_slide else None"
                   t-att-href="'/slides/slide/%s' % (slug(next_slide)) if next_slide else '#'">
                    Siguiente<i class="fa fa-chevron-right ms-2"/>
                </a>
            </div>
        </xpath>

    </template>
</odoo>
