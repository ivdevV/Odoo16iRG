<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Formulario del Wizard de Recalculate -->
        <record id="survey_auto_score_wizard_form_view" model="ir.ui.view">
            <field name="name">survey.auto_score.wizard.form</field>
            <field name="model">survey.auto_score.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <div class="alert alert-info">
                        <p>
                            Los puntajes ya están asignados en todas las respuestas correctas.
                        </p>
                        <p style="margin-top: 10px;">
                            ¿Desea <strong>recalcular las calificaciones</strong> de todos los intentos existentes
                            para reflejar los puntajes actuales?
                        </p>
                    </div>
                    <footer>
                        <button name="action_recalculate" string="Actualizar Calificaciones" type="object" class="btn-primary"/>
                        <button name="action_cancel" string="Cancelar" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
