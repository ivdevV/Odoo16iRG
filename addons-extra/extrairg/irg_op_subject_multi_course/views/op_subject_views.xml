<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_subject_form_multi_course" model="ir.ui.view">
        <field name="name">op.subject.form.multi.course</field>
        <field name="model">op.subject</field>
        <field name="inherit_id" ref="openeducat_core_enterprise.op_subject_from_view_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='course_id']" position="replace">
                <field name="course_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="course_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_op_subject_tree_multi_course" model="ir.ui.view">
        <field name="name">op.subject.tree.multi.course</field>
        <field name="model">op.subject</field>
        <field name="inherit_id" ref="openeducat_core_enterprise.op_subject_tree_view_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='course_id']" position="replace">
                <field name="course_ids" widget="many2many_tags" optional="hide"/>
                <field name="course_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
