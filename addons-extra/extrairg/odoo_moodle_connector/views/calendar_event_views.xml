<odoo>
    <data>

        <record id="calendar_event_view_extend" model="ir.ui.view">
            <field name="name">calendar.event.form</field>
            <field name="model">calendar.event</field>
            <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='page_details']" position="after">
                    <page name="moodle" string="Moodle">
                        <group col="4" colspan="4">
                            <field name="slide_id" widget="many2one" options="{'no_create': True, 'no_create_edit':True}"/>
                            <field name="is_visible" widget="boolean_toggle"/>
                            <field name="md_id"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>