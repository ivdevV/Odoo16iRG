<odoo>
    <data>
        
        <record model="ir.ui.view" id="moodle_credentials_list">
            <field name="name">Moodle Credentials List</field>
            <field name="model">moodle.credentials</field>
            <field name="arch" type="xml">
                <form edit="false" create="false">
                    <sheet>
                        <group string="Moodle Credentials">
                            <field name="request_url" style="width:50%" />
                            <field name="access_token" style="width:50%" password="True" />
                        </group>
                        <button name="connect" type="object" string="Save" class="oe_highlight" target="_blank"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="moodle_credentials_action_window">
            <field name="name">Moodle Credentials</field>
            <field name="res_model">moodle.credentials</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
        </record>
        
    </data>
</odoo>