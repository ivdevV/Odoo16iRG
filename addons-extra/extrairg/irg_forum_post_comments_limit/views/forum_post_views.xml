<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forum_post_form_inherit_allow_comments" model="ir.ui.view">
        <field name="name">forum.post.form.inherit.allow.comments</field>
        <field name="model">forum.post</field>
        <field name="inherit_id" ref="website_forum.view_forum_post_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_correct']" position="after">
                <field name="allow_comments" />
            </xpath>
        </field>
    </record>
</odoo>
