<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_student_form_inherit_diploma" model="ir.ui.view">
        <field name="name">op.student.form.inherit.diploma</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_irg_diploma_wizard)d" 
                        type="action" 
                        string="Generar Diploma" 
                        class="oe_highlight"
                        context="{'default_student_id': active_id}"/>
            </xpath>
        </field>
    </record>
</odoo>
