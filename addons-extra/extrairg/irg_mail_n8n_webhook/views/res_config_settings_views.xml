<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_irg_mail_n8n" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.irg.mail.n8n</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="IRG Mail n8n" string="IRG Mail n8n" data-key="irg_mail_n8n_webhook">
                    <h2>IRG Mail n8n</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="irg_mail_n8n_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="irg_mail_n8n_enabled"/>
                                <div class="text-muted">Redirige el correo saliente de Odoo a n8n.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="irg_mail_n8n_webhook_url"/>
                                <field name="irg_mail_n8n_webhook_url" placeholder="https://n8n.example.com/webhook/odoo-mail"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="irg_mail_n8n_auth_token"/>
                                <field name="irg_mail_n8n_auth_token" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="irg_mail_n8n_timeout"/>
                                <field name="irg_mail_n8n_timeout"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="irg_mail_n8n_max_attempts"/>
                                <field name="irg_mail_n8n_max_attempts"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="irg_mail_n8n_max_attachment_mb"/>
                                <field name="irg_mail_n8n_max_attachment_mb"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="irg_mail_n8n_debug_payload"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="irg_mail_n8n_debug_payload"/>
                                <div class="text-muted">Solo para depuracion controlada.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>