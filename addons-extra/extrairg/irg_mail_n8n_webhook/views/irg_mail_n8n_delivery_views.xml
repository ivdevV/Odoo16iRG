<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_irg_mail_n8n_delivery_tree" model="ir.ui.view">
        <field name="name">irg.mail.n8n.delivery.tree</field>
        <field name="model">irg.mail.n8n.delivery</field>
        <field name="arch" type="xml">
            <tree string="Entregas n8n" create="false">
                <field name="create_date"/>
                <field name="mail_id"/>
                <field name="state"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at"/>
                <field name="response_status"/>
                <field name="idempotency_key"/>
            </tree>
        </field>
    </record>

    <record id="view_irg_mail_n8n_delivery_form" model="ir.ui.view">
        <field name="name">irg.mail.n8n.delivery.form</field>
        <field name="model">irg.mail.n8n.delivery</field>
        <field name="arch" type="xml">
            <form string="Entrega n8n" create="false">
                <header>
                    <button name="action_retry_now" type="object" string="Reintentar" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancelar"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent,failed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="mail_id"/>
                            <field name="idempotency_key" readonly="1"/>
                            <field name="payload_hash" readonly="1"/>
                            <field name="webhook_url" readonly="1"/>
                        </group>
                        <group>
                            <field name="attempt_count" readonly="1"/>
                            <field name="last_attempt_at" readonly="1"/>
                            <field name="next_attempt_at" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Respuesta">
                            <group>
                                <field name="response_status" readonly="1"/>
                                <field name="failure_reason" readonly="1"/>
                                <field name="response_body" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_irg_mail_n8n_delivery" model="ir.actions.act_window">
        <field name="name">Entregas n8n</field>
        <field name="res_model">irg.mail.n8n.delivery</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_irg_mail_n8n_root" name="Mail n8n" parent="base.menu_administration" groups="base.group_system" sequence="95"/>
    <menuitem id="menu_irg_mail_n8n_delivery" name="Entregas" parent="menu_irg_mail_n8n_root" action="action_irg_mail_n8n_delivery" groups="base.group_system" sequence="10"/>
</odoo>