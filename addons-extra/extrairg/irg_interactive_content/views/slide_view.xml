<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_slide_slide_form_irg_interactive" model="ir.ui.view">
        <field name="name">slide.slide.form.irg.interactive</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="interactive_content" string="Interactive Content">
                    <group>
                        <group>
                            <field name="x_is_interactive"/>
                            <field name="x_original_slide_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="x_interactive_json" widget="text" nolabel="1" placeholder='{"mermaid_code": "graph TD; A-->B;", "flashcards": [], "content_html": "", "quiz": []}'/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <template id="slide_content_detailed_irg_interactive" inherit_id="website_slides.slide_content_detailed" name="Slide Content Detailed - IRG Interactive">
        <xpath expr="//div[@t-if=&quot;slide.slide_category == 'document'&quot;]" position="before">
            <div t-if="slide.slide_category == 'document' and slide.x_is_interactive" class="o_irg_interactive_content bg-white p-3 rounded">
                <t t-set="interactive_payload" t-value="slide._get_interactive_payload()"/>

                <div class="mb-4" t-if="interactive_payload.get('mermaid_code')">
                    <h5 class="mb-3">Diagram</h5>
                    <div class="mermaid" t-esc="interactive_payload.get('mermaid_code')"/>
                </div>

                <div class="mb-4" t-if="interactive_payload.get('flashcards')">
                    <h5 class="mb-3">Flashcards</h5>
                    <div class="row g-3">
                        <t t-foreach="interactive_payload.get('flashcards', [])" t-as="card">
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card h-100 border" x-data="{ flipped: false }">
                                    <label class="card-body d-flex flex-column justify-content-center text-center mb-0" style="cursor: pointer;">
                                        <input type="checkbox" class="d-none" x-model="flipped"/>
                                        <strong class="mb-2" x-show="!flipped" x-cloak="1" t-esc="card.get('term', '')"/>
                                        <span x-show="flipped" x-cloak="1" t-esc="card.get('definition', '')"/>
                                    </label>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="mb-4" t-if="interactive_payload.get('content_html')">
                    <h5 class="mb-3">Content</h5>
                    <div class="o_irg_interactive_html" t-raw="interactive_payload.get('content_html')"/>
                </div>

                <div t-if="interactive_payload.get('quiz')">
                    <h5 class="mb-3">Quiz</h5>
                    <t t-foreach="interactive_payload.get('quiz', [])" t-as="quiz_item">
                        <div class="card mb-3" t-att-x-data="'{ selectedIndex: null, correctIndex: %s }' % quiz_item.get('correct_index', -1)">
                            <div class="card-body">
                                <p class="fw-bold mb-2" t-esc="quiz_item.get('question', '')"/>
                                <div class="d-grid gap-2">
                                    <t t-foreach="range(len(quiz_item.get('options', [])))" t-as="option_index">
                                        <label class="btn btn-outline-primary text-start mb-0">
                                            <input type="radio" class="d-none" x-model="selectedIndex" t-att-value="option_index"/>
                                            <span t-esc="quiz_item.get('options', [])[option_index]"/>
                                        </label>
                                    </t>
                                </div>
                                <div class="mt-2 fw-bold" x-show="selectedIndex !== null" x-cloak="1">
                                    <span class="text-success" x-show="selectedIndex == correctIndex">Correct</span>
                                    <span class="text-danger" x-show="selectedIndex != correctIndex">Incorrect</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@t-if=&quot;slide.slide_category == 'document'&quot;]" position="attributes">
            <attribute name="t-if">slide.slide_category == 'document' and not slide.x_is_interactive</attribute>
        </xpath>
    </template>

</odoo>
