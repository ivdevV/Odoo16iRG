<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inyecta los campos de configuración de libreta automática en el
        formulario de Curso (op.course), justo zdespués del campo
        'gradebook_id' añadido por isep_gradebook.
    -->
    <record id="view_op_course_form_inherit_auto_gradebook" model="ir.ui.view">
        <field name="name">op.course.form.inherit.auto.gradebook</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_core.view_op_course_form"/>
        <field name="arch" type="xml">
            <field name="gradebook_id" position="after">
                <field name="auto_create_gradebook"/>
                <field name="auto_gradebook_subject_filter"
                       attrs="{'invisible': [('auto_create_gradebook', '=', False)]}"/>
            </field>
        </field>
    </record>
</odoo>
