<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista del wizard -->
    <record id="view_irg_admission_export_wizard_form" model="ir.ui.view">
        <field name="name">irg.admission.export.wizard.form</field>
        <field name="model">irg.admission.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Admisiones">

                <!-- Estado: elegir formato -->
                <group attrs="{'invisible': [('state', '=', 'done')]}">
                    <group>
                        <field name="register_id" readonly="1"/>
                        <field name="export_format"/>
                    </group>
                </group>

                <!-- Estado: descarga lista -->
                <group attrs="{'invisible': [('state', '=', 'choose')]}">
                    <group>
                        <field name="file_data" widget="binary" filename="filename" readonly="1" string="Descargar archivo"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <p class="text-success">
                            El archivo ha sido generado. Haz clic en el enlace para descargarlo.
                        </p>
                    </group>
                </group>

                <field name="state" invisible="1"/>

                <footer>
                    <button name="action_export"
                            string="Exportar"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción que abre el wizard desde el menú Acciones del formulario de op.admission.register -->
    <record id="action_irg_admission_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportar Admisiones</field>
        <field name="res_model">irg.admission.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="openeducat_admission.model_op_admission_register"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
