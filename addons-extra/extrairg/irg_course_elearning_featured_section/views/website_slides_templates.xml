<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="course_slides_list_featured_section" inherit_id="website_slides.course_slides_list" name="Course Slides List - IRG Featured Section" priority="120">
        <xpath expr="//div[hasclass('o_wslides_slides_list')]" position="before">
            <t t-set="irg_featured_section" t-value="channel.irg_get_featured_section_values()"/>
            <section t-if="irg_featured_section" class="o_irg_featured_section card border-0 shadow-sm mb-4 overflow-hidden">
                <style>
                    .o_irg_featured_section_embed {
                        width: 100% !important;
                        max-width: 800px !important;
                        margin-top: 1rem !important;
                    }
                    .o_irg_featured_section_embed iframe {
                        width: 100% !important;
                        height: auto !important;
                        aspect-ratio: 16 / 9 !important;
                        border: 0 !important;
                    }
                </style>
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-column flex-md-row gap-3 justify-content-between">
                        <div class="o_irg_featured_section_content flex-grow-1">
                            <span class="o_irg_featured_section_badge text-uppercase fw-semibold mb-2 d-inline-flex align-items-center">
                                Destacado
                            </span>
                            <h2 class="h4 mb-3" t-esc="irg_featured_section['title']"/>
                            <div t-if="irg_featured_section['body']" class="o_irg_featured_section_body text-muted" t-out="irg_featured_section['body']"/>
                            <div t-if="irg_featured_section['embed_code']" class="o_irg_featured_section_embed mt-3" t-out="irg_featured_section['embed_code']"/>
                        </div>
                        <div t-if="irg_featured_section['url']" class="o_irg_featured_section_action flex-shrink-0 align-self-md-end">
                            <a class="btn btn-primary" t-att-href="irg_featured_section['url']">
                                <span t-esc="irg_featured_section['button_label']"/>
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
