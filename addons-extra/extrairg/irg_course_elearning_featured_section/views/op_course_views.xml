<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_course_form_featured_section" model="ir.ui.view">
        <field name="name">op.course.form.featured.section.irg</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_core.view_op_course_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Destacado eLearning" name="irg_elearning_featured_section">
                    <group>
                        <field name="irg_featured_section_enabled"/>
                    </group>
                    <group attrs="{'invisible': [('irg_featured_section_enabled', '=', False)]}">
                        <field name="irg_featured_section_title" attrs="{'required': [('irg_featured_section_enabled', '=', True)]}"/>
                        <field name="irg_featured_section_body" widget="html" options="{'safe': True}" nolabel="1"/>
                        <group string="Botón opcional">
                            <field name="irg_featured_section_url" placeholder="https://..."/>
                            <field name="irg_featured_section_button_label" attrs="{'invisible': [('irg_featured_section_url', '=', False)]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
