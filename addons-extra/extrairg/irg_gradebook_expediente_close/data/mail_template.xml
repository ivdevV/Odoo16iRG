<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_expediente_close" model="mail.template">
            <field name="name">Cierre de expediente — Aviso a académica</field>
            <field name="model_id" ref="isep_gradebook.model_app_gradebook_student"/>
            <field name="subject">CIERRE DE EXPEDIENTE: {{ object.student_id.display_name }} — {{ object.admission_id.application_number or '' }} — {{ object.course_id.display_name }}</field>
            <field name="email_from">Instituto Raimon Gaja &lt;academica@institutoraimongaja.com&gt;</field>
            <field name="email_to">academica@institutoraimongaja.com</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                    <p><strong>CIERRE DE EXPEDIENTE</strong></p>
                    <p>La libreta de calificaciones ha quedado finalizada y se ha registrado la fecha de cierre de expediente.</p>
                    <table style="border-collapse: collapse; width: 100%; margin: 12px 0;">
                        <tr>
                            <td style="padding: 5px 10px; background: #f5f5f5; font-weight: bold; width: 40%;">Alumno</td>
                            <td style="padding: 5px 10px;"><t t-out="object.student_id.display_name or ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 10px; background: #f5f5f5; font-weight: bold;">Correo del alumno</td>
                            <td style="padding: 5px 10px;"><t t-out="object.partner_id.email or ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 10px; background: #f5f5f5; font-weight: bold;">Curso</td>
                            <td style="padding: 5px 10px;"><t t-out="object.course_id.display_name or ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 10px; background: #f5f5f5; font-weight: bold;">Admisión</td>
                            <td style="padding: 5px 10px;"><t t-out="object.admission_id.application_number or ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 10px; background: #f5f5f5; font-weight: bold;">Libreta</td>
                            <td style="padding: 5px 10px;"><t t-out="object.name or ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 10px; background: #f5f5f5; font-weight: bold;">Fecha de cierre de expediente</td>
                            <td style="padding: 5px 10px;"><t t-out="format_date(object.student_id.file_closing_date, date_format='dd/MM/yyyy') or ''"/></td>
                        </tr>
                    </table>
                </div>
            </field>
        </record>
    </data>
</odoo>
