<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Añade la pestaña "Contenido Interactivo" al formulario de slide.slide -->
    <record id="view_slide_slide_form_irg_html_embed" model="ir.ui.view">
        <field name="name">slide.slide.form.irg.html.embed</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="irg_content_interactive" string="Contenido Interactivo">
                    <group string="Contenido Interactivo">
                        <group>
                            <field name="irg_use_html_embed"/>
                        </group>
                        <group/>
                        <field name="irg_html_embed_code" widget="text" colspan="2"
                               attrs="{'invisible': [('irg_use_html_embed', '=', False)]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
