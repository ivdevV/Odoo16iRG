<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: Suspender suscripciones con cuotas vencidas -->
        <record id="cron_subscription_overdue_check" model="ir.cron">
            <field name="name">IRG: Verificar suscripciones con cuotas vencidas</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">False</field>
            <field name="doall">False</field>
        </record>

        <!-- Cron: Reactivar suscripciones que ya pagaron -->
        <record id="cron_subscription_reactivate" model="ir.cron">
            <field name="name">IRG: Reactivar suscripciones pagadas</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_reactivate_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">False</field>
            <field name="doall">False</field>
        </record>

        <record id="cron_subscription_apply_grace" model="ir.cron">
            <field name="name">IRG: Aplicar fin de gracia Stripe</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_apply_stripe_grace_period()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">False</field>
            <field name="doall">False</field>
        </record>

        <!-- Cron: Reintentar creación de suscripciones Stripe pendientes -->
        <record id="cron_retry_pending_stripe_subscriptions" model="ir.cron">
            <field name="name">IRG: Reintentar suscripciones Stripe pendientes</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_pending_stripe_subscriptions()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">False</field>
            <field name="doall">False</field>
        </record>

    </data>
</odoo>
