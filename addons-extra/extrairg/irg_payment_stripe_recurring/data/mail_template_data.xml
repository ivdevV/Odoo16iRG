<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_payment_link_reminder" model="mail.template">
            <field name="name">IRG Stripe: Recordatorio de pago</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="email_from">{{ (object.company_id.email or object.user_id.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="subject">Recordatorio de pago - {{ object.name }}</field>
            <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px; font-size: 14px;">
    <p>Estimado/a <strong>{{ object.partner_id.name }}</strong>,</p>

    <p>Le recordamos que tiene una factura pendiente de pago correspondiente a su suscripción
       <strong>{{ object.name }}</strong>.</p>

    <table style="margin: 16px 0; border-collapse: collapse;">
        <tr>
            <td style="padding: 4px 12px 4px 0; font-weight: bold;">Referencia:</td>
            <td style="padding: 4px 0;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 4px 12px 4px 0; font-weight: bold;">Importe:</td>
            <td style="padding: 4px 0;">{{ "%.2f"|format(object.amount_total) }} {{ object.currency_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 4px 12px 4px 0; font-weight: bold;">Recordatorio nº:</td>
            <td style="padding: 4px 0;">{{ object.stripe_reminder_count }}</td>
        </tr>
    </table>

    <p>Puede realizar el pago de forma segura a través del siguiente enlace:</p>

    <p style="margin: 20px 0;">
        <a href="{{ object.stripe_hosted_invoice_url }}"
           style="background-color: #875A7B; color: #ffffff; padding: 10px 24px;
                  text-decoration: none; border-radius: 4px; font-weight: bold;">
            Pagar ahora
        </a>
    </p>

    <p style="color: #888888; font-size: 12px;">
        Si ya ha realizado el pago, por favor ignore este mensaje.
    </p>

    <p>Atentamente,<br/>{{ object.company_id.name }}</p>
</div>
]]></field>
        </record>

    </data>
</odoo>
