<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="irg_stripe_res_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.irg.stripe</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <field name="irg_stripe_customer_id" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
