<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Extiende la plantilla del perfil del alumno para aplicar la lógica de
        visibilidad de asignaturas por lote definida en irg_op_subject_visibility.

        Cadena de herencia (por priority, ascendente = se aplica antes):
            base (16):  isep_website_custom.user_profile_content_details
                        subject_ids = course_id.subject_ids
            prio 16:    irg_subject_slide_fix
                        subject_ids = batch.subject_to_batch_ids (filtra por lote)
            prio 25:    este template (se aplica el último)
                        subject_ids = course_id.get_subjects_visible_for_batch(batch)
                        → parte de TODOS los subjects del curso, luego aplica
                          nuestra lógica de visibilidad; ignora subject_to_batch_ids.
    -->
    <template id="user_profile_subject_visibility"
              name="Subject Visibility Portal Filter"
              inherit_id="isep_website_custom.user_profile_content_details"
              priority="25">

        <!--
            Insertamos antes de t-set='slide_channel_ids' (que no modifica irg_subject_slide_fix)
            para sobreescribir subject_ids con nuestro método Python seguro.
        -->
        <xpath expr="//t[@t-set='slide_channel_ids']" position="before">
            <!-- Obtener la admisión más reciente del alumno en este curso -->
            <t t-set="student_admission_vis"
               t-value="env['op.admission'].sudo().search(
                   [('partner_id', '=', user.partner_id.id),
                    ('course_id',  '=', course_id.id)],
                   order='id desc', limit=1
               )"/>
            <t t-set="student_batch_vis"
               t-value="student_admission_vis.batch_id if student_admission_vis else False"/>

            <!--
                Sobreescribir subject_ids usando el método Python del modelo,
                que parte de course_id.subject_ids (todos los del curso) y aplica
                los campos visible_all_course_batches / batch_visibility_ids.
                Evita la dependencia de subject_to_batch_ids para subjects nuevos.
            -->
            <t t-set="subject_ids"
               t-value="course_id.get_subjects_visible_for_batch(student_batch_vis)"/>
        </xpath>

    </template>
</odoo>
