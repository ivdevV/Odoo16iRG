<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Override product price to show monthly installment -->
    <template id="product_price_monthly" inherit_id="website_sale.product_price" priority="100">
        <xpath expr="//span[hasclass('oe_price')]" position="replace">
            <t t-set="selected_months" t-value="combination_info.get('months', 1)"/>
            <t t-set="selected_price" t-value="combination_info.get('price', 0.0)"/>
            <!-- Use direct division of selected price by months; remove frontend/server display normalization -->
            <t t-set="display_price" t-value="(selected_price / selected_months) if selected_months &gt; 1 else selected_price"/>
            <t t-set="display_months" t-value="selected_months"/>

            <t t-if="display_price">
                <span class="oe_price" style="white-space: nowrap;" t-esc="display_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <span class="text-muted isep_month_suffix" style="font-size: 0.8rem;" t-if="display_months &gt; 1">
                    <t t-esc="' / %s meses' % display_months"/>
                </span>
                <span id="isep_monthly_price_active" style="display:none;"
                      t-att-data-months="selected_months"
                      t-att-data-min-months="combination_info.get('min_installment_months', selected_months)">Active-Selected-Installment</span>
            </t>
            <t t-else="">
                <span class="oe_price" style="white-space: nowrap;" t-esc="combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <span id="isep_monthly_price_active" style="display:none;"
                      t-att-data-months="combination_info.get('months', 1)"
                      t-att-data-min-months="combination_info.get('min_installment_months', combination_info.get('months', 1))">Active-Single</span>
            </t>
        </xpath>
    </template>

    <!-- Cart/listing overrides removed to keep installation robust across themes/versions. -->
</odoo>
