<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_marketing_event_tracking" model="ir.ui.view">
        <field name="name">crm.lead.view.form.marketing.event.tracking</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']//group[@name='categorization']//field[@name='company_id']" position="before">
                <field name="irg_event_id"/>
            </xpath>
            <xpath expr="//page[@name='extra']//group[.//field[@name='irg_fecha_reactivacion']]" position="inside">
                <field name="event_id_reactivacion"/>
                <field name="irg_ad_reactivacion"/>
            </xpath>
        </field>
    </record>
</odoo>
