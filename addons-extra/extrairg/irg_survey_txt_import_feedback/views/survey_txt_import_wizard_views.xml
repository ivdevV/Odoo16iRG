<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_survey_txt_import_wizard_form" model="ir.ui.view">
        <field name="name">irg.survey.txt.import.wizard.form</field>
        <field name="model">irg.survey.txt.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar preguntas TXT">
                <group>
                    <group>
                        <field name="survey_id" readonly="1"/>
                        <field name="txt_file" filename="txt_filename"/>
                        <field name="txt_filename" invisible="1"/>
                        <field name="parsed_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="sample_format" readonly="1" nolabel="1" widget="text"/>
                    </group>
                </group>
                <group>
                    <field name="preview_text" readonly="1" nolabel="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_preview" type="object" string="Vista previa" class="btn-secondary"/>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
