<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== FORM VIEW ===== -->
    <record id="irg_discount_program_view_form" model="ir.ui.view">
        <field name="name">irg.discount.program.form</field>
        <field name="model">irg.discount.program</field>
        <field name="arch" type="xml">
            <form string="Programa de Descuento">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del programa"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuración">
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="description"/>
                            <field name="target_product_id"/>
                        </group>
                        <group string="Uso">
                            <field name="usage_limit"/>
                            <field name="usage_count"/>
                            <field name="combinable"/>
                        </group>
                    </group>
                    <group string="Fórmula de Descuento">
                        <field name="formula" widget="ace" options="{'mode': 'python'}" placeholder="amount_untaxed * 0.10"/>
                    </group>
                    <group>
                        <group string="Restricciones de fecha">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Restricciones de importe">
                            <field name="min_amount"/>
                            <field name="max_discount"/>
                        </group>
                    </group>
                    <group string="Clientes específicos">
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Variables disponibles en la fórmula:</strong>
                        <ul>
                            <li><code>amount_untaxed</code> — Total sin impuestos del pedido</li>
                            <li><code>amount_total</code> — Total con impuestos del pedido</li>
                            <li><code>qty_total</code> — Cantidad total de productos</li>
                            <li><code>line_count</code> — Número de líneas de producto</li>
                            <li><code>product_amount</code> — Subtotal sin impuestos del producto objetivo</li>
                            <li><code>order</code> — El objeto sale.order completo</li>
                            <li><code>min(a, b)</code>, <code>max(a, b)</code>, <code>abs(x)</code>, <code>round(x, n)</code></li>
                        </ul>
                        <strong>Ejemplos:</strong>
                        <ul>
                            <li><code>amount_untaxed * 0.10</code> → 10% de descuento</li>
                            <li><code>product_amount * 0.20</code> → 20% del producto objetivo</li>
                            <li><code>min(amount_untaxed * 0.15, 500)</code> → 15% con tope de 500€</li>
                            <li><code>100 if amount_untaxed > 1000 else 50</code> → 100€ si supera 1000, sino 50€</li>
                        </ul>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===== TREE VIEW ===== -->
    <record id="irg_discount_program_view_tree" model="ir.ui.view">
        <field name="name">irg.discount.program.tree</field>
        <field name="model">irg.discount.program</field>
        <field name="arch" type="xml">
            <tree string="Programas de Descuento">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="formula"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="min_amount"/>
                <field name="max_discount"/>
                <field name="usage_count"/>
                <field name="usage_limit"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ===== SEARCH VIEW ===== -->
    <record id="irg_discount_program_view_search" model="ir.ui.view">
        <field name="name">irg.discount.program.search</field>
        <field name="model">irg.discount.program</field>
        <field name="arch" type="xml">
            <search string="Buscar Programas de Descuento">
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="valid_today" string="Válidos hoy"
                        domain="['|', ('date_from', '=', False), ('date_from', '&lt;=', context_today().strftime('%%Y-%%m-%%d')),
                                 '|', ('date_to', '=', False), ('date_to', '&gt;=', context_today().strftime('%%Y-%%m-%%d'))]"/>
            </search>
        </field>
    </record>

    <!-- ===== ACTION ===== -->
    <record id="irg_discount_program_action" model="ir.actions.act_window">
        <field name="name">Descuentos con Fórmula</field>
        <field name="res_model">irg.discount.program</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer programa de descuento con fórmula personalizada
            </p>
            <p>
                Define códigos de descuento con fórmulas Python para calcular el importe.
            </p>
        </field>
    </record>

    <!-- ===== MENU ===== -->
    <menuitem id="irg_discount_menu_root"
              name="Descuentos IRG"
              parent="sale.sale_menu_root"
              sequence="90"/>

    <menuitem id="irg_discount_menu_programs"
              name="Programas de Descuento"
              parent="irg_discount_menu_root"
              action="irg_discount_program_action"
              sequence="10"/>

</odoo>
