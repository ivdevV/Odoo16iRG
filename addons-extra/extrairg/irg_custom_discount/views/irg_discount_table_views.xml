<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="irg_discount_table_view_tree" model="ir.ui.view">
        <field name="name">irg.discount.table.tree</field>
        <field name="model">irg.discount.table</field>
        <field name="arch" type="xml">
            <tree string="Tablas IRG">
                <field name="name"/>
                <field name="year"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="irg_discount_table_view_form" model="ir.ui.view">
        <field name="name">irg.discount.table.form</field>
        <field name="model">irg.discount.table</field>
        <field name="arch" type="xml">
            <form string="Tabla IRG">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="year"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                    </group>
                    <group string="Líneas de tarifa">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="category_code"/>
                                <field name="modality"/>
                                <field name="months"/>
                                <field name="installment_amount"/>
                                <field name="total_amount"/>
                                <field name="discount_percent"/>
                                <field name="product_id"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="irg_discount_table_action" model="ir.actions.act_window">
        <field name="name">Tablas IRG</field>
        <field name="res_model">irg.discount.table</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="irg_discount_menu_tables"
              name="Tablas de Tarifas"
              parent="irg_discount_menu_root"
              action="irg_discount_table_action"
              sequence="20"/>

</odoo>
