<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Override the ticket form title and header to use 'Atención al Alumno' -->
    <template id="ticket_submit_form_override" inherit_id="website_helpdesk.ticket_submit_form">
      <xpath expr="//t[@t-set='additional_title']" position="replace">
        <t t-set="additional_title">Atención al Alumno</t>
      </xpath>
      <xpath expr="//h1[contains(., 'Ingresar un tíquet')]" position="replace">
        <h1>Ingresar un tíquet - Atención al Alumno</h1>
      </xpath>
      <xpath expr="//h2[contains(@class,'text-muted')]" position="replace">
        <h2 class="text-muted">Atención al Alumno</h2>
      </xpath>
      <xpath expr="//*[contains(text(), 'Más de 50,000 clientes confían en nosotros')]" position="replace">
        <h2>Miles de Alumnos confían en iRG para potenciar su carrera.</h2>
      </xpath>
    </template>
  </data>
</odoo>
