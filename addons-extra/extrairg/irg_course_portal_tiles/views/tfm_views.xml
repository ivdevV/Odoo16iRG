                <div class="row mt-3">
                    <div class="col-md-8">
                        <h4>Descripción</h4>
                        <div t-if="course and course.description"><t t-raw="course.description"/></div>
                        <div t-if="not (course and course.description)" class="text-muted">No hay descripción disponible.</div>

                        <h4 class="mt-4">Supervisores</h4>
                        <ul>
                            <t t-foreach="supervisors" t-as="s">
                                <li><t t-esc="s.name"/></li>
                            </t>
                        </ul>

                        <h4 class="mt-4">Documentos</h4>
                        <ul>
                            <t t-foreach="documents" t-as="doc">
                                <li>
                                    <a t-att-href="'/web/content/%s' % (doc.id)"><t t-esc="doc.name"/></a>
                                    <small class="text-muted"> — <t t-esc="doc.create_date"/></small>
                                </li>
                            </t>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <div class="card p-3">
                            <div class="text-center mb-3">
                                <img t-att-src="'/irg_course_portal_tiles/static/src/img/icon-docs.svg'" style="width:64px;"/>
                            </div>
                            <h5>Subir TFM</h5>
                            <p class="text-muted">Funcionalidad de subida pendiente. Actualmente puede adjuntar archivos en la sección de documentos del curso.</p>
                            <a class="btn btn-primary" t-att-href="'/web#id=%s&amp;model=op.course&amp;view_type=form' % (course.id)">Ir al curso</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
