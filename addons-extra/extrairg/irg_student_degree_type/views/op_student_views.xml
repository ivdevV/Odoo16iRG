<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_student_form_degree_type" model="ir.ui.view">
        <field name="name">op.student.form.degree.type</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <field name="emergency_contact" position="after">
                <field name="irg_degree_type_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
            </field>
        </field>
    </record>

    <record id="view_op_student_tree_degree_type" model="ir.ui.view">
        <field name="name">op.student.tree.degree.type</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="irg_degree_type_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
