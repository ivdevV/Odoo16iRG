<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_irg_partner_safe_merge_wizard_form" model="ir.ui.view">
        <field name="name">irg.partner.safe.merge.wizard.form</field>
        <field name="model">irg.partner.safe.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Safe merge contacts" create="0" delete="0">
                <group>
                    <group string="Selection">
                        <field name="master_partner_id" readonly="1"/>
                        <field name="source_partner_id" readonly="1"/>
                        <button name="action_swap" type="object" string="Swap master and source"
                                class="btn-secondary"
                                attrs="{'invisible': [('preview_ready', '=', True)]}"/>
                    </group>
                    <group string="Recommendation">
                        <field name="recommendation_reason" nolabel="1" readonly="1"/>
                        <field name="prevalidation_status" nolabel="1" readonly="1"/>
                    </group>
                </group>
                <separator string="Scalar field decisions"/>
                <field name="conflict_ids" nolabel="1"
                       attrs="{'readonly': [('preview_ready', '=', True)]}">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="field_name" readonly="1"/>
                        <field name="master_value" readonly="1"/>
                        <field name="source_value" readonly="1"/>
                        <field name="requires_choice" readonly="1"/>
                        <field name="choice"/>
                    </tree>
                </field>
                <separator string="Closed relation inventory"/>
                <field name="inventory_json" nolabel="1" readonly="1" widget="text"/>
                <field name="preview_hash" readonly="1" groups="base.group_no_one"/>
                <field name="preview_ready" invisible="1"/>
                <group attrs="{'invisible': [('preview_ready', '=', False)]}">
                    <field name="confirmation_checked"/>
                </group>
                <footer>
                    <button name="action_preview" type="object" string="Generate final preview"
                            class="btn-primary"
                            attrs="{'invisible': [('preview_ready', '=', True)]}"/>
                    <button name="action_confirm" type="object" string="Confirm safe merge"
                            class="btn-primary"
                            attrs="{'invisible': [('preview_ready', '=', False)]}"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_irg_partner_safe_merge_wizard" model="ir.actions.act_window">
        <field name="name">Safe merge</field>
        <field name="res_model">irg.partner.safe.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_irg_partner_safe_merge_wizard_form"/>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
