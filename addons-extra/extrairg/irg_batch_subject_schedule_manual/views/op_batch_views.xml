<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_batch_form_subject_schedule_manual" model="ir.ui.view">
        <field name="name">op.batch.form.subject.schedule.manual</field>
        <field name="model">op.batch</field>
        <field name="inherit_id" ref="isep_elearning_custom.custom_op_batch_subject_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pro_subject']/field[@name='subject_to_batch_ids']" position="before">
                <field name="irg_course_subject_ids" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='pro_subject']//field[@name='subject_to_batch_ids']/tree/field[@name='subject_id']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="domain">[('id', 'in', parent.irg_course_subject_ids)]</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath expr="//page[@name='pro_subject']//field[@name='subject_to_batch_ids']/tree/field[@name='code']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>