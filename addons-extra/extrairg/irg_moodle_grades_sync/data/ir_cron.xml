<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_sync_moodle_grades" model="ir.cron">
            <field name="name">Moodle: sincronizar notas de alumnos</field>
            <field name="model_id" ref="model_irg_moodle_grade"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_moodle_grades()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(minutes=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
