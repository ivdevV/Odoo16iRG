<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forum_visibility_batch_tree" model="ir.ui.view">
        <field name="name">forum.visibility.batch.tree</field>
        <field name="model">forum.visibility.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_forum_visibility_batch_form" model="ir.ui.view">
        <field name="name">forum.visibility.batch.form</field>
        <field name="model">forum.visibility.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_forum_visibility_batch" model="ir.actions.act_window">
        <field name="name">Forum Batches</field>
        <field name="res_model">forum.visibility.batch</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_forum_visibility_batch"
        name="Forum Batches"
        parent="website.main_menu"
        action="action_forum_visibility_batch"
        sequence="120"
        groups="base.group_system"
    />

    <record id="view_users_form_forum_batch_visibility" model="ir.ui.view">
        <field name="name">res.users.form.forum.batch.visibility</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="forum_visibility" string="Forum Visibility">
                    <group>
                        <field name="forum_batch_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_forum_forum_form_batch_visibility" model="ir.ui.view">
        <field name="name">forum.forum.form.batch.visibility</field>
        <field name="model">forum.forum</field>
        <field name="inherit_id" ref="website_forum.view_forum_forum_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="visibility_batch_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
