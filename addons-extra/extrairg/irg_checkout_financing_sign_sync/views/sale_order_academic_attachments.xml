<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="irg_sale_order_view_form_academic_attachments" model="ir.ui.view">
        <field name="name">sale.order.form.academic.attachments.irg</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_recalculate_financing" string="Recalcular Financiación" type="object" states="draft,sent"/>
            </xpath>
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Doc. académica" name="irg_academic_docs_page">
                    <group>
                        <field name="academic_attachment_count" readonly="1"/>
                    </group>
                    <field name="academic_attachment_ids" nolabel="1" readonly="1">
                        <tree string="Documentación académica" create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="mimetype"/>
                            <field name="create_date"/>
                            <field name="create_uid"/>
                            <field name="description"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
