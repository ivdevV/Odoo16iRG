<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="irg_payment_confirmation_academic_upload" inherit_id="website_sale.payment_confirmation_status" priority="260">
        <xpath expr="//div[hasclass('alert-warning')]" position="after">
            <t t-set="last_order_id" t-value="request.session.get('sale_last_order_id')"/>
            <t t-set="last_order" t-value="last_order_id and request.env['sale.order'].sudo().browse(last_order_id) or False"/>
            <t t-if="last_order and last_order.exists() and last_order.state in ('sale', 'done')">
                <div class="alert alert-info mt-3 mb-3" role="alert">
                    <strong>Documentación académica</strong>
                    <p class="mb-2">Si lo deseas, puedes adjuntar aquí tu documentación académica para agilizar la validación.</p>
                    <form action="/shop/academic_documents/upload" method="post" enctype="multipart/form-data" class="row g-2">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="order_id" t-att-value="last_order.id"/>
                        <div class="col-12 col-md-8">
                            <input type="file" name="academic_documents" class="form-control" multiple="multiple" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"/>
                        </div>
                        <div class="col-12 col-md-4 text-md-end">
                            <button type="submit" class="btn btn-primary">Adjuntar documentación</button>
                        </div>
                    </form>
                    <t t-if="request.params.get('academic_upload') == 'ok'">
                        <p class="mt-2 mb-0 text-success">Documentación subida correctamente.</p>
                    </t>
                    <t t-if="request.params.get('academic_upload') == 'empty'">
                        <p class="mt-2 mb-0 text-warning">No se recibió ningún archivo.</p>
                    </t>
                    <t t-if="request.params.get('academic_upload') == 'forbidden'">
                        <p class="mt-2 mb-0 text-danger">No se pudo validar el pedido para adjuntar archivos.</p>
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
