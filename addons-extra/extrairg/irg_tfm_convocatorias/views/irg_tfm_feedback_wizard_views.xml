<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_irg_tfm_esquema_feedback_wizard" model="ir.ui.view">
        <field name="name">irg.tfm.esquema.feedback.wizard.form</field>
        <field name="model">irg.tfm.esquema.feedback.wizard</field>
        <field name="arch" type="xml">
            <form string="Retroalimentación del esquema">
                <group>
                    <field name="outline_id" invisible="1"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Guardar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
