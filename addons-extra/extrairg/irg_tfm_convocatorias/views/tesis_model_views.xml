<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tesis_model_form_irg_tfm" model="ir.ui.view">
        <field name="name">tesis.model.form.irg.tfm</field>
        <field name="model">tesis.model</field>
        <field name="inherit_id" ref="isep_tesis_model.view_tesis_model_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='course_id']" position="after">
                <field name="irg_tfm_convocation_id"/>
                <field name="irg_tfm_activated_at" readonly="1"/>
            </xpath>
            <xpath expr="//sheet/group/group/field[@name='status_thesis']" position="attributes">
                <attribute name="attrs">{'invisible': [('irg_tfm_activated_at', '!=', False)]}</attribute>
            </xpath>
            <xpath expr="//page[.//field[@name='attachment2_ids']]" position="attributes">
                <attribute name="attrs">{'invisible': [('irg_tfm_activated_at', '!=', False)]}</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Entregas TFM">
                    <field name="irg_tfm_submission_ids" readonly="1">
                        <tree create="false" delete="false"
                              default_order="submitted_at desc, id desc">
                            <field name="stage"/>
                            <field name="version"/>
                            <field name="attachment_id" string="Archivo"/>
                            <field name="comment"/>
                            <field name="convocation_id"/>
                            <field name="submitted_by"/>
                            <field name="submitted_at"/>
                            <field name="internal_exception" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_tesis_model_search_irg_tfm" model="ir.ui.view">
        <field name="name">tesis.model.search.irg.tfm</field>
        <field name="model">tesis.model</field>
        <field name="inherit_id" ref="isep_tesis_model.view_tesis_model_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="TFM pendientes" name="irg_tfm_pending"
                        domain="[('irg_tfm_convocation_id', '=', False)]"/>
                <filter string="TFM asignadas" name="irg_tfm_assigned"
                        domain="[('irg_tfm_convocation_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
