<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_irg_tfm_outline_form" model="ir.ui.view">
        <field name="name">irg.tfm.esquema.form.reviewer</field>
        <field name="model">irg.tfm.esquema</field>
        <field name="arch" type="xml">
            <form string="Esquema TFM" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="thesis_id"/>
                            <field name="survey_title"/>
                            <field name="version"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="started_by"/>
                            <field name="started_at"/>
                            <field name="submitted_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Respuestas">
                            <field name="question_ids" readonly="1">
                                <tree create="false" delete="false" default_order="sequence, id">
                                    <field name="step_key"/>
                                    <field name="title"/>
                                    <field name="answer_text"/>
                                    <field name="selected_option_ids" widget="many2many_tags"/>
                                </tree>
                                <form string="Respuesta" create="false" edit="false" delete="false">
                                    <group>
                                        <field name="step_key"/>
                                        <field name="section_title"/>
                                        <field name="title"/>
                                        <field name="description" widget="html"/>
                                        <field name="question_type"/>
                                        <field name="mandatory"/>
                                        <field name="answer_text"
                                               attrs="{'invisible': [('question_type', 'in', ['simple_choice', 'multiple_choice'])]}"/>
                                        <field name="selected_option_ids" widget="many2many_tags"
                                               attrs="{'invisible': [('question_type', 'not in', ['simple_choice', 'multiple_choice'])]}"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_irg_tfm_outline_tree" model="ir.ui.view">
        <field name="name">irg.tfm.esquema.tree.reviewer</field>
        <field name="model">irg.tfm.esquema</field>
        <field name="arch" type="xml">
            <tree string="Esquemas TFM" create="false" delete="false"
                  default_order="version desc, submitted_at desc">
                <field name="version"/>
                <field name="survey_title"/>
                <field name="started_by"/>
                <field name="started_at"/>
                <field name="submitted_at"/>
            </tree>
        </field>
    </record>

    <record id="view_tesis_model_form_irg_tfm" model="ir.ui.view">
        <field name="name">tesis.model.form.irg.tfm</field>
        <field name="model">tesis.model</field>
        <field name="inherit_id" ref="isep_tesis_model.view_tesis_model_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='course_id']" position="after">
                <field name="irg_tfm_convocation_id"/>
                <field name="irg_tfm_activated_at" readonly="1"/>
            </xpath>
            <xpath expr="//sheet/group/group/field[@name='status_thesis']" position="attributes">
                <attribute name="attrs">{'invisible': [('irg_tfm_activated_at', '!=', False)]}</attribute>
            </xpath>
            <xpath expr="//page[.//field[@name='attachment2_ids']]" position="attributes">
                <attribute name="attrs">{'invisible': [('irg_tfm_activated_at', '!=', False)]}</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Esquemas" groups="irg_tfm_convocatorias.group_tfm_reviewer">
                    <field name="irg_tfm_outline_ids" readonly="1"
                           domain="[('state', '=', 'done')]"
                           context="{'tree_view_ref': 'irg_tfm_convocatorias.view_irg_tfm_outline_tree',
                                     'form_view_ref': 'irg_tfm_convocatorias.view_irg_tfm_outline_form'}"/>
                </page>
                <page string="Entregas TFM">
                    <field name="irg_tfm_submission_ids" readonly="1">
                        <tree create="false" delete="false"
                              default_order="submitted_at desc, id desc">
                            <field name="stage"/>
                            <field name="version"/>
                            <field name="attachment_id" string="Archivo"/>
                            <field name="comment"/>
                            <field name="convocation_id"/>
                            <field name="submitted_by"/>
                            <field name="submitted_at"/>
                            <field name="internal_exception" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_tesis_model_search_irg_tfm" model="ir.ui.view">
        <field name="name">tesis.model.search.irg.tfm</field>
        <field name="model">tesis.model</field>
        <field name="inherit_id" ref="isep_tesis_model.view_tesis_model_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="TFM pendientes" name="irg_tfm_pending"
                        domain="[('irg_tfm_convocation_id', '=', False)]"/>
                <filter string="TFM asignadas" name="irg_tfm_assigned"
                        domain="[('irg_tfm_convocation_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
