<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        Hereda del template de diseño (isep_website_custom_design) y reemplaza
        el bloque completo del contenido de asignaturas para corregir:
        1. Filtrar asignaturas por lote (batch) del estudiante.
        2. Determinar canales activos consultando slide.channel.partner con active=True.
        3. Verificar precedencia (can_be_taken) por cada asignatura.
    -->
    <template id="user_profile_content_details_irg_fix"
              name="IRG Subject Fix - Content Details"
              inherit_id="isep_website_custom_design.user_profile_content_details_design">

        <xpath expr="//t[@t-if='channel']/div" position="replace">
            <!-- Curso -->
            <t t-set="course_id" t-value="env['op.course'].sudo().browse(op_course_id)"/>

            <!-- Buscar la admisión del estudiante para obtener el lote -->
            <t t-set="student_admission" t-value="env['op.admission'].sudo().search([
                ('partner_id', '=', user.partner_id.id),
                ('course_id', '=', course_id.id),
                ('state', '=', 'done')], limit=1)"/>

            <!-- Asignaturas filtradas por lote (batch) del estudiante -->
            <t t-if="student_admission and student_admission.batch_id">
                 <t t-set="today_date" t-value="datetime.date.today()"/>
                 <!-- Filtrar solo asignaturas vigentes en fecha -->
                 <t t-set="valid_batch_lines" t-value="student_admission.batch_id.subject_to_batch_ids.filtered(lambda l: l.date_from and l.date_to and l.date_from &lt;= today_date and l.date_to &gt;= today_date)"/>
                 <t t-set="subject_ids" t-value="valid_batch_lines.mapped('subject_id')"/>
            </t>
            <t t-else="">
                <t t-set="subject_ids" t-value="course_id.subject_ids"/>
            </t>

            <!-- Canales ACTIVOS: consultar slide.channel.partner (incluyendo inactivos para evitar bloqueo por desincronización) -->
            <t t-set="active_channel_partners" t-value="env['slide.channel.partner'].sudo().search([
                ('partner_id', '=', user.partner_id.id),
                '|', ('active', '=', True), ('active', '=', False)])"/>
            <t t-set="slide_channel_active_ids" t-value="active_channel_partners.mapped('channel_id').ids"/>

            <!-- Cursos complementarios (no curriculares) -->
            <t t-set="slide_channel_ids" t-value="course_id.slide_channel_ids"/>
            <!-- Icono personalizado -->
            <t t-set="icon_course" t-value="request.env['course.admission.icon'].sudo().search([('type','=','course')], limit=1)"/>

            <div class="mb32">
                <h5 class="border-bottom pb-1"><t t-out="course_id.name"/></h5>
                <div class="row">

                    <!-- Cursos complementarios / no obligatorios -->
                    <div class="col-12 col-lg-6" t-foreach="slide_channel_ids" t-as="slide_id">
                        <div class="card mb-2">
                            <div class="card-body o_wprofile_slides_course_card_body p-0 d-flex"
                                 t-attf-style="#{'pointer-events: none;cursor: default;' if not slide_id.id in slide_channel_active_ids else ''}"
                                 t-attf-onclick="location.href='/slides/#{slide_id}';">
                                <div class="o_wslides_background_image ps-5 pe-4 rounded-start" t-if="icon_course"
                                     t-attf-style="#{'filter: grayscale(0.7);' if not slide_id.id in slide_channel_active_ids else ''} height: 72px; background-image: url(#{website.image_url(icon_course, 'image')});"/>
                                <div class="p-2 w-100" style="font-size: 13px;font-weight: 600;">
                                    <span class="mt-0 mb-1" t-field="slide_id.name"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Asignaturas curriculares con verificación de precedencia -->
                    <div class="col-12 col-lg-6" t-foreach="subject_ids" t-as="subject">
                        <div class="card mb-2">
                            <t t-set="slide_id" t-value="subject.slide_channel_id.id"/>
                            <!-- Verificar precedencia: ¿puede cursar esta asignatura? -->
                            <t t-set="can_be_taken" t-value="subject.can_be_taken(user.id)"/>
                            <div class="card-body o_wprofile_slides_course_card_body p-0 d-flex"
                                 t-attf-style="#{'pointer-events: none;cursor: default;' if not can_be_taken or not (slide_id in slide_channel_active_ids) else ''}"
                                 t-attf-onclick="#{'location.href=\'/slides/%s\'' % slide_id if can_be_taken and (slide_id in slide_channel_active_ids) else ''}">
                                <div class="o_wslides_background_image ps-5 pe-4 rounded-start" t-if="icon_course"
                                     t-attf-style="#{'filter: grayscale(0.7);' if not can_be_taken or not (slide_id in slide_channel_active_ids) else ''} height: 72px; background-image: url(#{website.image_url(icon_course, 'image')});"/>
                                <div class="p-2 w-100" style="font-size: 13px;font-weight: 600;">
                                    <span class="mt-0 mb-1" t-if="subject.code"><t t-esc="subject.code"/> - </span>
                                    <span class="mt-0 mb-1" t-field="subject.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div t-if="not subject_ids" class="text-muted d-inline-block">En proceso</div>
                </div>
            </div>
        </xpath>

    </template>

</odoo>
