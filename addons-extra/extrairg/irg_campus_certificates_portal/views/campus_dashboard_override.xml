<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="user_profile_content_details_certificates_tile" inherit_id="irg_course_portal_tiles.irg_user_profile_content_details_inherit">
            <xpath expr="//h5[contains(text(), 'Herramientas del curso')]/following-sibling::div[hasclass('row')]" position="inside">
                <div t-if="not hasattr(course_id, 'irg_is_diplomado') or not course_id.irg_is_diplomado()" class="col-12 col-sm-12 col-md-6 col-lg-4 p-2 student_tile_portal" name="certificates_and_diplomas">
                    <a class="row ms-0 me-0 w-auto p-3 dashboard_element_main_body d-flex align-items-center justify-content-between" t-attf-href="/campus/certificates?course_id=#{op_course_id}">
                        <div class="col-lg-12 text-center hover_effect">
                            <img class="image oe_portal_img mt16 mb16" src="/irg_course_portal_tiles/static/src/img/icon-docs.svg" style="width: 74px;"/>
                            <br/>
                            <span style="color: #fff;font-weight: bold;font-size: 16px;">Certificados y Diplomas</span>
                        </div>
                    </a>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
