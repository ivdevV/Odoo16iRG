                    </div>
                </div>

                <!-- JavaScript dinámico para actualizar costes y validaciones -->
                <script type="text/javascript">
                    //<![CDATA[
                    (function () {
                        var docTypeSel = document.getElementById('document_type_select');
                        var certTypeSel = document.getElementById('cert_type_select');
                        var gbSel = document.getElementById('gradebook_select');
                        var shippingSel = document.getElementById('shipping_select');
                        
                        var shipBlock = document.getElementById('shipping_block');
                        var signerBlock = document.getElementById('signer_block');
                        var customOptBlock = document.getElementById('custom_options_block');
                        var customDescBlock = document.getElementById('custom_desc_block');
                        
                        var summaryDoc = document.getElementById('summary_document');
                        var summaryFormat = document.getElementById('summary_format');
                        var summaryBase = document.getElementById('summary_base_price');
                        var summaryShippingRow = document.getElementById('summary_shipping_row');
                        var summaryShipping = document.getElementById('summary_shipping_price');
                        var summaryTotal = document.getElementById('summary_total_price');
                        
                        var gbWarning = document.getElementById('gradebook_warning');
                        var submitBtn = document.getElementById('submit_btn');
                        
                        var PRICE_MAP = {
                            'digital': 30.0,
                            'physical': 40.0,
                            'custom': 40.0,
                            'physical_apostilled': 120.0
                        };
                        var SHIPPING_MAP = {
                            'national': 20.0,
                            'international': 60.0
                        };

                        function updateForm() {
                            var docType = docTypeSel ? docTypeSel.value : '';
                            var certType = certTypeSel ? certTypeSel.value : '';
                            var gbOption = gbSel ? gbSel.options[gbSel.selectedIndex] : null;
                            var gbState = gbOption ? gbOption.getAttribute('data-state') : '';
                            var shippingType = shippingSel ? shippingSel.value : '';

                            // 1. Mostrar/ocultar bloques condicionales
                            var isPhysical = (certType === 'physical' || certType === 'physical_apostilled');
                            var isCustom = (certType === 'custom');
                            var isDiploma = (docType === 'diploma');

                            if (shipBlock) {
                                shipBlock.style.display = isPhysical ? '' : 'none';
                                var shipInput = shipBlock.querySelector('select');
                                if (shipInput) {
                                    if (isPhysical) shipInput.setAttribute('required', 'required');
                                    else shipInput.removeAttribute('required');
                                }
                            }
                            if (signerBlock) signerBlock.style.display = isDiploma ? 'none' : '';
                            if (customOptBlock) customOptBlock.style.display = isCustom ? '' : 'none';
                            if (customDescBlock) customDescBlock.style.display = isCustom ? '' : 'none';

                            // 2. Validar estado de la libreta según tipo de documento
                            var invalidState = false;
                            if (gbOption && gbOption.value) {
                                if ((docType === 'gradebook' || docType === 'diploma') && gbState !== 'done') {
                                    invalidState = true;
                                }
                            }
                            if (gbWarning) gbWarning.style.display = invalidState ? '' : 'none';
                            if (submitBtn) {
                                if (invalidState) {
                                    submitBtn.setAttribute('disabled', 'disabled');
                                } else {
                                    submitBtn.removeAttribute('disabled');
                                }
                            }

                            // 3. Actualizar resumen de la solicitud
                            if (summaryDoc && docTypeSel) {
                                summaryDoc.textContent = docTypeSel.options[docTypeSel.selectedIndex].text;
                            }
                            if (summaryFormat && certTypeSel) {
                                summaryFormat.textContent = certTypeSel.value ? certTypeSel.options[certTypeSel.selectedIndex].text.split('—')[0].trim() : '-';
                            }

                            var basePrice = PRICE_MAP[certType] || 0.0;
                            var shippingPrice = isPhysical ? (SHIPPING_MAP[shippingType] || 0.0) : 0.0;
                            var total = basePrice + shippingPrice;

                            if (summaryBase) summaryBase.textContent = basePrice.toFixed(2) + ' €';
                            if (summaryShippingRow) {
                                summaryShippingRow.style.setProperty('display', isPhysical ? 'flex' : 'none', 'important');
                            }
                            if (summaryShipping) summaryShipping.textContent = shippingPrice.toFixed(2) + ' €';
                            if (summaryTotal) summaryTotal.textContent = total.toFixed(2) + ' €';
                        }

                        if (docTypeSel) docTypeSel.addEventListener('change', updateForm);
                        if (certTypeSel) certTypeSel.addEventListener('change', updateForm);
                        if (gbSel) {
                            gbSel.addEventListener('change', updateForm);
                            // Ejecutar una vez al cargar si Odoo ha preseleccionado por parámetro course_id
                            setTimeout(updateForm, 100);
                        }
                        if (shippingSel) shippingSel.addEventListener('change', updateForm);

                        updateForm();
                    })();
                    //]]>
                </script>
                <style>
                    .hover-lift-subtle {
                        transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
                    }
                    .hover-lift-subtle:hover {
                        transform: translateY(-1px);
                        border-color: #0d6efd !important;
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
                    }
                    .pointer-cursor {
                        cursor: pointer;
                    }
                    .hover-btn-primary:hover {
                        background-color: #002e5d !important;
                        transform: scale(1.02);
                        box-shadow: 0 4px 10px rgba(0, 46, 93, 0.25);
                    }
                </style>
            </xpath>
        </template>

    </data>
