<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        noupdate="0": estos registros se recrean/actualizan en cada -u,
        garantizando que siempre existan y estén activos.
    -->
    <data noupdate="0">

        <!-- DNI — Documento Nacional de Identidad -->
        <record id="it_dni" model="l10n_latam.identification.type">
            <field name="name">DNI</field>
            <field name="active">True</field>
        </record>

        <!-- Pasaporte -->
        <record id="it_pasaporte" model="l10n_latam.identification.type">
            <field name="name">Pasaporte</field>
            <field name="active">True</field>
        </record>

        <!-- Documento Identificativo (equivalente al tipo VAT genérico) -->
        <record id="it_documento_identificativo" model="l10n_latam.identification.type">
            <field name="name">Documento Identificativo</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
