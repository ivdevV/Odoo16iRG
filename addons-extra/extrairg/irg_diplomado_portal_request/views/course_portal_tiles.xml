<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="course_diplomado_specific_tile" inherit_id="irg_campus_certificates_portal.user_profile_content_details_certificates_tile">
            <xpath expr="//div[@name='certificates_and_diplomas']" position="attributes">
                <attribute name="t-if">not course_id.irg_is_diplomado()</attribute>
            </xpath>
            <xpath expr="//div[@name='certificates_and_diplomas']" position="after">
                <div t-if="course_id.irg_is_diplomado()" class="col-12 col-sm-12 col-md-6 col-lg-4 p-2 student_tile_portal" name="diplomado_diploma_request">
                    <a class="row ms-0 me-0 w-auto p-3 dashboard_element_main_body d-flex align-items-center justify-content-between" t-attf-href="/campus/diplomados/#{op_course_id}">
                        <div class="col-lg-12 text-center hover_effect">
                            <img class="image oe_portal_img mt16 mb16" src="/irg_course_portal_tiles/static/src/img/icon-docs.svg" style="width: 74px;"/>
                            <br/>
                            <span style="color: #fff;font-weight: bold;font-size: 16px;">Diploma del Diplomado</span>
                        </div>
                    </a>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
