<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="portal_diplomado_page" name="Solicitud de Diploma de Diplomado">
            <t t-call="website.layout">
                <div class="container py-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
                        <div>
                            <h2 class="h3 mb-1 text-primary fw-bold">Diploma del Diplomado</h2>
                            <p class="text-muted mb-0 small" t-out="course.name if course and course.exists() else ''"/>
                        </div>
                        <a t-if="course and course.exists()" t-attf-href="/campus/course/#{course.id}" class="btn btn-light border rounded-pill px-4">
                            <i class="fa fa-arrow-left me-1"/> Volver al curso
                        </a>
                    </div>

                    <t t-if="success">
                        <div class="alert alert-success border-start border-4 border-success shadow-sm mb-4" role="alert">
                            <i class="fa fa-check-circle me-2"/> <t t-out="success"/>
                        </div>
                    </t>
                    <t t-if="error">
                        <div class="alert alert-warning border-start border-4 border-warning shadow-sm mb-4" role="alert">
                            <i class="fa fa-exclamation-triangle me-2"/> <t t-out="error"/>
                        </div>
                    </t>

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                        <div class="card-body p-4">
                            <div class="row g-4 align-items-stretch">
                                <div class="col-12 col-lg-4">
                                    <div class="h-100 rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #37b6d8, #178cb4);">
                                        <i class="fa fa-certificate fa-3x mb-3"/>
                                        <h3 class="h5 fw-bold mb-2">Descarga gratuita</h3>
                                        <p class="mb-0 small opacity-75">Disponible al completar el diplomado con calificacion final superior a 7.0.</p>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-8">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4 text-muted">Estado academico</dt>
                                        <dd class="col-sm-8">
                                            <span t-if="gradebook" class="badge rounded-pill bg-success px-3 py-2">Completado</span>
                                            <span t-else="" class="badge rounded-pill bg-secondary px-3 py-2">No completado</span>
                                        </dd>
                                        <dt class="col-sm-4 text-muted">Calificacion final</dt>
                                        <dd class="col-sm-8 fw-bold">
                                            <t t-if="gradebook" t-out="'%.2f' % final_grade"/>
                                            <t t-else="">-</t>
                                        </dd>
                                        <dt class="col-sm-4 text-muted">Requisito</dt>
                                        <dd class="col-sm-8">Nota final superior a 7.0</dd>
                                        <dt class="col-sm-4 text-muted">Situacion</dt>
                                        <dd class="col-sm-8">
                                            <span t-if="diplomado_registry" class="badge rounded-pill bg-primary px-3 py-2">Emitido</span>
                                            <span t-elif="eligible" class="badge rounded-pill bg-success px-3 py-2">Disponible para descargar</span>
                                            <span t-else="" class="badge rounded-pill bg-light text-muted border px-3 py-2">No disponible</span>
                                        </dd>
                                    </dl>

                                    <div class="mt-4 d-flex flex-wrap gap-2">
                                        <a t-if="diplomado_registry" t-attf-href="/campus/diplomados/download/#{diplomado_registry.id}" class="btn btn-primary rounded-pill px-4">
                                            <i class="fa fa-download me-1"/> Descargar PDF
                                        </a>
                                        <form t-elif="eligible" t-attf-action="/campus/diplomados/#{course.id}/request" method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4">
                                                <i class="fa fa-download me-1"/> Descargar Diploma
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
