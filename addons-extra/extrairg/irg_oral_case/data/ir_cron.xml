<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_irg_oral_case_retention" model="ir.cron">
        <field name="name">IRG caso oral: retención de vídeo</field>
        <field name="model_id" ref="model_irg_oral_case_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_apply_video_retention()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_irg_oral_case_status" model="ir.cron">
        <field name="name">IRG caso oral: estado de n8n</field>
        <field name="model_id" ref="model_irg_oral_case_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_n8n_status()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
