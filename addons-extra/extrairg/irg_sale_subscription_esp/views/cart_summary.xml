<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="irg_cart_summary" inherit_id="website_sale.cart_summary" priority="200">
        <xpath expr="//table[hasclass('table')][1]/tbody[1]" position="replace">
            <tbody>
                <t t-set="summary_order" t-value="order or website_sale_order"/>
                <!-- Show ALL order lines for transparency -->
                <t t-set="lines" t-value="summary_order.order_line.filtered(lambda l: not l.display_type)"/>

                <t t-foreach="lines.filtered(lambda l: l.irg_line_type == 'master')" t-as="line">
                    <tr>
                        <td class="td-product_name"><t t-esc="line.name"/></td>
                        <td class="td-qty text-center"><t t-esc="line.product_uom_qty"/></td>
                        <td class="td-price text-end">
                            <span t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </td>
                    </tr>
                </t>

                <t t-foreach="lines.filtered(lambda l: l.irg_line_type == 'financing')" t-as="line">
                    <tr>
                        <td class="td-product_name"><t t-esc="line.name"/></td>
                        <td class="td-qty text-center"><t t-esc="line.product_uom_qty"/></td>
                        <td class="td-price text-end">
                            <span t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </td>
                    </tr>
                </t>

                <t t-foreach="lines.filtered(lambda l: l.irg_line_type == 'matricula')" t-as="line">
                    <tr>
                        <td class="td-product_name"><t t-esc="line.name"/></td>
                        <td class="td-qty text-center"><t t-esc="line.display_type and 1.0 or line.product_uom_qty"/></td>
                        <td class="td-price text-end">
                            <span t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </td>
                    </tr>
                </t>

                <t t-if="summary_order.term_number == 1" t-foreach="lines.filtered(lambda l: l.irg_line_type == 'matricula_discount')" t-as="line">
                    <tr>
                        <td class="td-product_name"><t t-esc="line.name"/></td>
                        <td class="td-qty text-center"><t t-esc="line.display_type and 1.0 or line.product_uom_qty"/></td>
                        <td class="td-price text-end">
                            <span t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </td>
                    </tr>
                </t>

                <t t-foreach="lines.filtered(lambda l: l.irg_line_type not in ['master', 'financing', 'matricula', 'matricula_discount'])" t-as="line">
                    <tr>
                        <td class="td-product_name"><t t-esc="line.name"/></td>
                        <td class="td-qty text-center"><t t-esc="line.product_uom_qty"/></td>
                        <td class="td-price text-end">
                            <span t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </xpath>

        <xpath expr="//table[hasclass('table')][1]" position="after">
            <t t-set="summary_order" t-value="order or website_sale_order"/>
            <t t-if="summary_order.term_number and summary_order.term_number &gt; 1">
                <t t-set="matricula_total" t-value="sum(summary_order.order_line.filtered(lambda l: l.irg_line_type == 'matricula').mapped('price_subtotal'))"/>
                <t t-set="monthly_amount" t-value="summary_order.subscription_schedule and summary_order.subscription_schedule[0].amount_recurring_taxinc or 0.0"/>
                <!-- number of installments requested (ignores 1st which may be paid now) -->
                <t t-set="term_count" t-value="summary_order.term_number or 0"/>
                <t t-set="installment_total" t-value="monthly_amount * term_count"/>
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td colspan="2" class="text-start">1ra Cuota + Matricula:</td>
                            <td class="text-end">
                                <span t-esc="monthly_amount + matricula_total" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="text-start">Cuotas restantes (<t t-esc="term_count - 1"/>):</td>
                            <td class="text-end">
                                <span t-esc="monthly_amount" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="text-start">Total en <t t-esc="term_count"/> cuotas:</td>
                            <td class="text-end">
                                <span t-esc="installment_total + matricula_total" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
    </template>
</odoo>
