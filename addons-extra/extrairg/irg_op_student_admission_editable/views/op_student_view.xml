<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Standalone form view for app.gradebook.subject
            opened via action button. No readonly restriction on
            gradebook_result_ids so scoring_total is always editable.
        -->
        <record id="view_gradebook_subject_editable_form" model="ir.ui.view">
            <field name="name">view.gradebook.subject.editable.form</field>
            <field name="model">app.gradebook.subject</field>
            <field name="arch" type="xml">
                <form string="Asignatura" create="0" delete="0">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="in_progress,done"/>
                    </header>

                    <field name="show_exam" invisible="1"/>
                    <field name="admission_id" invisible="1"/>
                    <field name="course_id" invisible="1"/>
                    <field name="gradebook_student_id" invisible="1"/>

                    <sheet>
                        <div class="oe_title">
                            <h2><field name="name"/></h2>
                        </div>
                        <group>
                            <group>
                                <field name="op_subject_id" required="1"
                                       options="{'no_open': True, 'no_create': True}"/>
                                <field name="final_subject_note"/>
                            </group>
                            <group>
                                <label for="point_average_exam"
                                       attrs="{'invisible': [('show_exam','=', False)]}"/>
                                <div name="point_average_exam_div" class="d-flex"
                                     attrs="{'invisible': [('show_exam','=', False)]}">
                                    <field name="point_average_exam" class="oe_inline mx-3"/>
                                    <span class="oe_inline o_form_label mx-3">=> </span>
                                    <field name="info_exam"/>
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page string="Evaluaciones" name="exams">
                                <!-- No attrs → always editable regardless of state -->
                                <field name="gradebook_result_ids"
                                       context="{'default_admission_id': admission_id}">
                                    <tree editable="bottom" delete="0">
                                        <field name="survey_type" optional="show" required="1"/>
                                        <field name="description"/>
                                        <field name="name" optional="hide" readonly="0" force_save="1"/>
                                        <field name="scoring_total"/>
                                        <field name="post_qty"
                                               attrs="{'invisible': [('survey_type','!=','foro')]}"/>
                                        <field name="comment" optional="hide"/>
                                        <field name="channel_id" optional="hide"
                                               options="{'no_open': True, 'no_create': True}"/>
                                        <field name="channel_partner_id" optional="hide"
                                               options="{'no_open': True, 'no_create': True}"/>
                                        <field name="survey_user_input_id" optional="hide"
                                               options="{'no_open': True, 'no_create': True}"/>
                                        <field name="gradebook_subject_id" optional="hide"/>
                                        <button name="unlink" confirm="Eliminar?" title="Eliminar"
                                                icon="fa-times" type="object"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Opciones" name="options">
                                <group>
                                    <group>
                                        <field name="gradebook_id" options="{'no_create': True}"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!--
            Override the inline admission form in the student's "Educativo" tab.
            Subjects are shown read-only with an "Editar" button that opens
            the standalone form above, fully bypassing the One2many readonly chain.
        -->
        <record id="view_op_student_admission_editable" model="ir.ui.view">
            <field name="name">view.op.student.admission.editable</field>
            <field name="model">op.student</field>
            <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
            <field name="priority" eval="24"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='op_admission_ids']/form" position="replace">
                    <form string="Detalle de admisión">
                        <group>
                            <group>
                                <field name="admission_date"/>
                                <field name="application_number" string="Matrícula"/>
                                <field name="course_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="batch_id" options="{'no_create': True}"
                                       context="{'course_id': course_id, 'get_parent_batch': 1}"/>
                                <field name="due_date"/>
                                <field name="state"/>
                            </group>
                        </group>

                        <separator string="Asignaturas"/>
                        <field name="gradebook_subject_ids" nolabel="1" readonly="1">
                            <tree string="Asignaturas" create="0" delete="0">
                                <field name="name" string="Asignatura"/>
                                <field name="point_average_assignment" string="AVG Asignaciones"/>
                                <field name="point_average_exam" string="AVG Exámenes"/>
                                <field name="point_average_interaction" string="AVG Interacciones"/>
                                <field name="point_average_foro" string="AVG Foro"/>
                                <field name="final_subject_note" string="Calificación final"/>
                                <button name="action_open_editable" type="object"
                                        string="Editar" icon="fa-pencil"
                                        class="btn-link"/>
                            </tree>
                        </field>
                    </form>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
