<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="course_slides_list_hide_practice_sections"
        inherit_id="irg_elearning_editable_sections.course_slides_list_hide_restricted_sections"
    >
        <xpath expr="//t[@t-foreach='category_data']" position="attributes">
            <attribute name="t-if">
                not category['id']
                or (
                    (not category['category'].allowed_batch_ids
                     or category['category'].is_user_allowed_by_batch(request.env.user))
                    and (not category['category'].irg_has_practice_requirement()
                         or category['category'].is_user_allowed_by_practice_type(request.env.user))
                )
            </attribute>
        </xpath>
    </template>

    <template
        id="fullscreen_sidebar_hide_practice_sections"
        inherit_id="irg_elearning_editable_sections.fullscreen_sidebar_hide_restricted_sections"
    >
        <xpath expr="//li[contains(@class, 'o_wslides_fs_sidebar_section')]" position="attributes">
            <attribute name="t-if">
                not category
                or (
                    (not category.allowed_batch_ids
                     or category.is_user_allowed_by_batch(request.env.user))
                    and (not category.irg_has_practice_requirement()
                         or category.is_user_allowed_by_practice_type(request.env.user))
                )
            </attribute>
        </xpath>
    </template>

    <template
        id="slide_fullscreen_sidebar_practice_hide"
        inherit_id="irg_batch_slide_restrictions.slide_fullscreen_sidebar_batch_hide"
    >
        <xpath expr="//li[contains(@t-attf-class,'o_wslides_fs_sidebar_list_item')]" position="attributes">
            <attribute name="t-if">not (batch_blocked_slide_ids and slide.id in batch_blocked_slide_ids) and not (practice_blocked_slide_ids and slide.id in practice_blocked_slide_ids)</attribute>
        </xpath>
    </template>

    <template id="slide_practice_restriction_error" name="Slide Practice Restriction Error">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading">Contenido Bloqueado</h4>
                    <p>
                        El contenido <strong><t t-esc="slide.name"/></strong> no puedes visualizarlo
                        con tu modalidad de prácticas actual.
                    </p>
                    <hr/>
                    <p class="mb-0">
                        <a t-att-href="slide.channel_id.website_url" class="btn btn-primary">
                            Volver a la asignatura
                        </a>
                    </p>
                </div>
            </div>
        </t>
    </template>
</odoo>
