<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_irg_auto_translate_res_config_settings" model="ir.ui.view">
    <field name="name">irg.auto.translate.settings</field>
    <field name="model">res.config.settings</field>
    <field name="arch" type="xml">
      <form string="IRG Auto Translate Settings">
        <sheet>
          <group>
            <field name="irg_auto_translate_provider"/>
            <field name="irg_auto_translate_api_key" password="True"/>
          </group>
        </sheet>
        <footer>
          <button string="Save" class="btn-primary" type="object" name="execute"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
