<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="portal_certificate_list_diplomados_override" inherit_id="irg_campus_certificates_portal.portal_certificate_list_override">
            
            <!-- Ocultar el botón superior "+ Nueva Solicitud" si sólo se muestran los diplomados -->
            <xpath expr="//a[@href='/campus/certificates/new']" position="attributes">
                <attribute name="t-if">not only_diplomados</attribute>
            </xpath>

            <!-- Inyectar las alertas al principio de la página -->
            <xpath expr="//t[@t-if=&quot;request.params.get('error') == 'no_pdf'&quot;]" position="before">
                <t t-if="request.params.get('error') == 'grade_too_low'">
                    <div class="alert alert-danger alert-dismissible fade show border-start border-4 border-danger shadow-sm mb-4" role="alert">
                        <i class="fa fa-times-circle me-2 text-danger"/>
                        <strong>Calificación insuficiente:</strong> No cumples con los requisitos académicos de calificación final mínima (7.0) para poder imprimir este diploma.
                    </div>
                </t>
                <t t-if="request.params.get('error') == 'already_requested'">
                    <div class="alert alert-warning alert-dismissible fade show border-start border-4 border-warning shadow-sm mb-4" role="alert">
                        <i class="fa fa-exclamation-triangle me-2 text-warning"/>
                        <strong>Ya solicitado:</strong> Este diploma ya ha sido solicitado o emitido previamente.
                    </div>
                </t>
                <t t-if="request.params.get('request_success') == '1'">
                    <div class="alert alert-success alert-dismissible fade show border-start border-4 border-success shadow-sm mb-4" role="alert">
                        <i class="fa fa-check-circle me-2 text-success"/>
                        <strong>Solicitud enviada:</strong> Tu solicitud de expedición de diploma de posgrado/diplomado ha sido enviada con éxito. Secretaría académica procederá a su expedición a la mayor brevedad.
                    </div>
                </t>
            </xpath>

            <!-- Modificar las pestañas existentes para que se oculten condicionalmente -->
            <xpath expr="//button[@id='diplomas-tab']" position="attributes">
                <attribute name="t-if">not only_diplomados</attribute>
            </xpath>
            <xpath expr="//button[@id='actas-tab']" position="attributes">
                <attribute name="t-if">not only_diplomados</attribute>
            </xpath>
            <xpath expr="//button[@id='solicitudes-tab']" position="attributes">
                <attribute name="t-if">not only_diplomados</attribute>
            </xpath>

            <!-- Inyectar la pestaña "Mis Diplomados" después de "Mis Diplomas" -->
            <xpath expr="//button[@id='diplomas-tab']/parent::li" position="after">
                <li class="nav-item" role="presentation">
                    <button t-attf-class="nav-link py-3 fw-bold border-0 rounded-0 {{ 'active' if only_diplomados else '' }}" 
                            id="diplomados-tab" 
                            data-bs-toggle="tab" 
                            data-bs-target="#diplomados-pane" 
                            type="button" 
                            role="tab" 
                            aria-controls="diplomados-pane" 
                            t-att-aria-selected="'true' if only_diplomados else 'false'" 
                            style="font-size: 1.05rem;">
                        <i class="fa fa-certificate me-2 text-primary"/>Mis Diplomados
                    </button>
                </li>
            </xpath>

            <!-- Modificar los paneles de contenido existentes para que se oculten condicionalmente -->
            <xpath expr="//div[@id='diplomas-pane']" position="attributes">
                <attribute name="t-if">not only_diplomados</attribute>
            </xpath>
            <xpath expr="//div[@id='actas-pane']" position="attributes">
                <attribute name="t-if">not only_diplomados</attribute>
            </xpath>
            <xpath expr="//div[@id='solicitudes-pane']" position="attributes">
                <attribute name="t-if">not only_diplomados</attribute>
            </xpath>

            <!-- Inyectar el panel de contenido de la pestaña "Mis Diplomados" -->
            <xpath expr="//div[@id='diplomas-pane']" position="after">
                <div t-attf-class="tab-pane fade {{ 'show active' if only_diplomados else '' }}" id="diplomados-pane" role="tabpanel" aria-labelledby="diplomados-tab">
                    
                    <t t-if="not diplomados_data and not disponibles_solicitar and not solicitudes_tramite">
                        <div class="text-center py-5 text-muted">
                            <i class="fa fa-certificate fa-3x mb-3" style="color: #cbd5e1;"/>
                            <p class="mb-0">No se encontraron títulos de posgrados o diplomados en tu expediente académico.</p>
                        </div>
                    </t>

                    <t t-if="diplomados_data or disponibles_solicitar or solicitudes_tramite">
                        <div class="mb-4">
                            <p class="text-muted small">Desde esta sección puedes gestionar la solicitud y descarga de tus diplomas de posgrados y diplomados. La emisión de estos títulos es gratuita.</p>
                        </div>

                        <!-- SECCIÓN 1: DIPLOMAS EMITIDOS -->
                        <t t-if="diplomados_data">
                            <div class="mb-4">
                                <h5 class="fw-bold text-dark mb-3"><i class="fa fa-check-square-o text-success me-2"/>Tus Títulos Emitidos</h5>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="border-0 px-3 py-3">Código de Registro</th>
                                                <th class="border-0 py-3">Programa / Curso</th>
                                                <th class="border-0 py-3 text-center">Calificación</th>
                                                <th class="border-0 py-3">Fecha de Expedición</th>
                                                <th class="border-0 py-3 text-center">Tipo</th>
                                                <th class="border-0 px-3 py-3 text-end"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="diplomados_data" t-as="d">
                                                <tr>
                                                    <td class="px-3 py-3">
                                                        <span class="font-monospace fw-bold text-dark" t-out="d['record'].name"/>
                                                    </td>
                                                    <td class="py-3">
                                                        <span class="fw-semibold text-dark" t-out="d['record'].diplomado_name or d['record'].course_id.name"/>
                                                    </td>
                                                    <td class="py-3 text-center">
                                                        <span t-attf-class="fw-bold {{ 'text-success' if d['can_download'] else 'text-danger' }}">
                                                            <t t-out="'%.2f' % d['final_grade']"/>
                                                        </span>
                                                    </td>
                                                    <td class="py-3">
                                                        <t t-out="d['record'].issue_date.strftime('%d/%m/%Y') if d['record'].issue_date else ''"/>
                                                    </td>
                                                    <td class="py-3 text-center">
                                                        <span class="badge rounded-pill bg-light text-primary px-3 py-2 border border-primary-subtle">
                                                            <t t-out="dict(d['record'].fields_get(['diploma_type'])['diploma_type']['selection']).get(d['record'].diploma_type, d['record'].diploma_type)"/>
                                                        </span>
                                                    </td>
                                                    <td class="px-3 py-3 text-end">
                                                        <t t-if="d['can_download']">
                                                            <a t-attf-href="/campus/certificates/download/diplomado/{{ d['record'].id }}" class="btn btn-sm btn-outline-primary rounded-pill px-3 transition-all hover-btn-download">
                                                                <i class="fa fa-download me-1"/> Descargar PDF
                                                            </a>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center gap-1" title="Calificación insuficiente para descarga (mínimo 7.0)">
                                                                <i class="fa fa-lock"/> Bloqueado
                                                            </span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>

                        <!-- SECCIÓN 2: DISPONIBLES PARA SOLICITAR -->
                        <t t-if="disponibles_solicitar">
                            <div class="mb-4 pt-3 border-top">
                                <h5 class="fw-bold text-dark mb-3"><i class="fa fa-plus-circle text-primary me-2"/>Títulos Disponibles para Solicitar</h5>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="border-0 px-3 py-3">Programa / Curso</th>
                                                <th class="border-0 py-3 text-center">Calificación Final</th>
                                                <th class="border-0 px-3 py-3 text-end"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="disponibles_solicitar" t-as="gb">
                                                <tr>
                                                    <td class="px-3 py-3">
                                                        <span class="fw-semibold text-dark" t-out="gb.course_id.name"/>
                                                        <t t-if="gb.batch_id"> (<t t-out="gb.batch_id.name"/>)</t>
                                                    </td>
                                                    <td class="py-3 text-center">
                                                        <span class="fw-bold text-success" t-out="'%.2f' % gb.total_final"/>
                                                    </td>
                                                    <td class="px-3 py-3 text-end">
                                                        <a t-attf-href="/campus/certificates/request/diplomado/{{ gb.course_id.id }}" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 transition-all hover-btn-payment">
                                                            <i class="fa fa-paper-plane me-1"/> Solicitar Diploma
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>

                        <!-- SECCIÓN 3: SOLICITUDES EN TRÁMITE -->
                        <t t-if="solicitudes_tramite">
                            <div class="mb-4 pt-3 border-top">
                                <h5 class="fw-bold text-dark mb-3"><i class="fa fa-clock-o text-warning me-2"/>Expediciones en Trámite</h5>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="border-0 px-3 py-3">Código Solicitud</th>
                                                <th class="border-0 py-3">Programa / Curso</th>
                                                <th class="border-0 py-3">Fecha Solicitud</th>
                                                <th class="border-0 py-3 text-center">Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="solicitudes_tramite" t-as="req">
                                                <tr>
                                                    <td class="px-3 py-3">
                                                        <span class="font-monospace fw-bold text-dark" t-out="req.name"/>
                                                    </td>
                                                    <td class="py-3">
                                                        <span class="fw-semibold text-dark" t-out="req.course_id.name"/>
                                                    </td>
                                                    <td class="py-3">
                                                        <t t-out="req.request_date.strftime('%d/%m/%Y') if req.request_date else ''"/>
                                                    </td>
                                                    <td class="py-3 text-center">
                                                        <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                                                            <i class="fa fa-spinner fa-spin me-1"/> En trámite
                                                        </span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>

                    </t>
                </div>
            </xpath>

        </template>

    </data>
</odoo>
