<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_irg_crm_translation_audit_wizard_form" model="ir.ui.view">
        <field name="name">irg.crm.translation.audit.wizard.form</field>
        <field name="model">irg.crm.translation.audit.wizard</field>
        <field name="arch" type="xml">
            <form string="Auditor de traducciones CRM">
                <group>
                    <group>
                        <field name="lang_id"/>
                        <field name="include_isep_crm"/>
                    </group>
                    <group>
                        <field name="name_filter"/>
                    </group>
                </group>
                <footer>
                    <button name="action_refresh" type="object" string="Actualizar resumen" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
                <separator string="Resultado"/>
                <field name="result_html" widget="html" nolabel="1" readonly="1"/>
            </form>
        </field>
    </record>

    <record id="action_irg_crm_translation_audit" model="ir.actions.act_window">
        <field name="name">Auditor de traducciones CRM</field>
        <field name="res_model">irg.crm.translation.audit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_name_filter': 'crm'}</field>
    </record>

    <menuitem
        id="menu_irg_crm_translation_audit"
        name="Auditor de traducciones CRM"
        parent="crm.crm_menu_config"
        action="action_irg_crm_translation_audit"
        sequence="95"
        groups="base.group_system"/>
</odoo>
