<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_irg_campus_activity_audit_wizard_form" model="ir.ui.view">
        <field name="name">irg.campus.activity.audit.wizard.form</field>
        <field name="model">irg.campus.activity.audit.wizard</field>
        <field name="arch" type="xml">
            <form string="Informe de actividad de campus">
                <group attrs="{'invisible': [('state', '=', 'done')]}">
                    <group>
                        <field name="batch_id" readonly="1"/>
                        <field name="listado_filename" invisible="1"/>
                        <field name="listado_file" filename="listado_filename"/>
                    </group>
                    <group>
                        <p>
                            Se incluirán los alumnos matriculados en este lote.
                            Si se adjunta un listado, el cruce es por correo y las filas
                            sin matrícula en el lote irán a la hoja «No encontrados».
                        </p>
                    </group>
                </group>
                <group attrs="{'invisible': [('state', '=', 'choose')]}">
                    <group>
                        <field name="file_data" widget="binary" filename="filename" readonly="1"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <p class="text-success">
                            El informe se ha generado. Pulsa el enlace para descargarlo.
                        </p>
                    </group>
                </group>
                <field name="state" invisible="1"/>
                <footer>
                    <button name="action_generate"
                            string="Generar informe"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_irg_campus_activity_audit_wizard" model="ir.actions.act_window">
        <field name="name">Informe de actividad</field>
        <field name="res_model">irg.campus.activity.audit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="openeducat_core.model_op_batch"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
    </record>
</odoo>
