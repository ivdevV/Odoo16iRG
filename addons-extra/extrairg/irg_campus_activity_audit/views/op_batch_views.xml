<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_batch_form_campus_activity_audit" model="ir.ui.view">
        <field name="name">op.batch.form.campus.activity.audit</field>
        <field name="model">op.batch</field>
        <field name="inherit_id" ref="openeducat_core.view_op_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_open_campus_activity_audit"
                        type="object"
                        string="Informe de actividad"
                        class="btn-primary"
                        groups="openeducat_core.group_op_faculty"/>
            </xpath>
        </field>
    </record>
</odoo>
