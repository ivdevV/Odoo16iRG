<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-extend="website.slides.fullscreen.content">
        <t t-jquery="t:last" t-operation="after">
            <t t-if="widget.get('slide').category === 'url'">
                <div class="o_irg_url_slide_fullscreen d-flex align-items-center justify-content-center h-100 p-4">
                    <t t-raw="widget.get('slide').embedCode"/>
                </div>
            </t>
        </t>
    </t>
</templates>
