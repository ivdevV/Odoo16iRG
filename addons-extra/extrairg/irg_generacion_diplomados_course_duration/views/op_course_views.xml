<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_course_form_inherit_diplomado_duration" model="ir.ui.view">
        <field name="name">op.course.form.inherit.diplomado.duration</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="irg_generacion_diplomados.view_op_course_form_inherit_irg"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='diplomado_subjects']/group" position="before">
                <group string="Datos del Diploma">
                    <group>
                        <field name="irg_diplomado_duration_hours"/>
                    </group>
                    <group>
                        <field name="irg_diplomado_duration_ects"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
