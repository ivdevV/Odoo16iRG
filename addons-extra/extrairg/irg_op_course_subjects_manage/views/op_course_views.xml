<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_course_form_subjects_manage" model="ir.ui.view">
        <field name="name">op.course.form.subjects.manage</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_core.view_op_course_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='subject']/field[@name='subject_ids']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
