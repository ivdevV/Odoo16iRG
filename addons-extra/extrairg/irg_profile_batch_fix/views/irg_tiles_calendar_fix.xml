<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Bug #2 Fix (parte XML): El tile "Calendario" en la página de curso
        usa menu_calendar.link como href genérico, sin contexto de batch.
        Esto hace que el calendario cargue sesiones de TODOS los programas
        del alumno.

        Esta herencia reemplaza el <a> del tile del calendario para añadir
        ?batch_id=X cuando student_batch_id está disponible en el contexto
        (lo inyecta el controller IrgProfileBatchFixCourseOverride).

        La herencia apunta a irg_course_portal_tiles.irg_user_profile_content_details_inherit
        que a su vez hereda isep_website_custom.user_profile_content_details.
        Usamos el <a> exacto que existe dentro del t-if="menu_calendar".
    -->
    <template
        id="irg_profile_batch_fix_calendar_link"
        name="IRG: Fix link calendario con batch_id"
        inherit_id="irg_course_portal_tiles.irg_user_profile_content_details_inherit"
    >
        <xpath
            expr="//t[@t-if='menu_calendar']/a"
            position="replace"
        >
            <t t-set="calendar_href"
               t-value="menu_calendar.link + ('?batch_id=' + str(student_batch_id) if student_batch_id else '')"/>
            <a class="row ms-0 me-0 w-auto p-3 dashboard_element_main_body d-flex align-items-center justify-content-between"
               t-att-href="calendar_href">
                <div class="col-lg-12 text-center hover_effect">
                    <img class="image oe_portal_img mt16 mb16"
                         t-att-src="image_data_uri(menu_calendar.icon_image)"
                         style="width: 74px;"/>
                    <br/>
                    <span style="color: #fff;font-weight: bold;font-size: 16px;">
                        <t t-esc="(menu_calendar.name.replace('Cliente','Alumno') if menu_calendar.name else '')"/>
                    </span>
                </div>
            </a>
        </xpath>
    </template>

</odoo>
