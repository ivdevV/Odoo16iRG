<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_certificate_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="id_type_name"
                       t-value="o.partner_id.l10n_latam_identification_type_id.name if o.partner_id.l10n_latam_identification_type_id else False"/>
                    <t t-set="id_number" t-value="o.partner_id.vat or ''"/>
                    <t t-set="subjects"
                       t-value="o.gradebook_student_id.gradebook_subject_ids.filtered(
                           lambda s: s.op_subject_id.subject_type == 'compulsory'
                       )"/>

                    <div class="article" style="font-family: 'Times New Roman', Times, Georgia, serif; color: #1a1a1a;">
                        <style>
                            /* ---- Certificate global styles ---- */
                            .cert-page {
                                position: relative;
                                padding: 0 30px 0 30px;
                                min-height: 100%;
                            }
                            .cert-header {
                                text-align: center;
                                padding-top: 8px;
                                margin-bottom: 6px;
                            }
                            .cert-header img {
                                max-height: 80px;
                            }
                            .cert-title {
                                text-align: center;
                                margin: 18px 0 22px 0;
                            }
                            .cert-title h1 {
                                font-size: 22px;
                                font-weight: 700;
                                letter-spacing: 4px;
                                text-transform: uppercase;
                                margin: 0;
                                color: #1a1a1a;
                            }
                            .cert-title .cert-subtitle {
                                font-size: 12px;
                                font-style: italic;
                                color: #555;
                                margin-top: 4px;
                            }
                            .cert-body {
                                text-align: justify;
                                font-size: 12px;
                                line-height: 1.7;
                                margin-bottom: 14px;
                                padding: 0 8px;
                            }
                            .cert-body strong {
                                font-weight: 700;
                            }
                            /* ---- Grade table ---- */
                            .cert-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 14px;
                                font-size: 11px;
                            }
                            .cert-table th {
                                background-color: #2c3e50;
                                color: #ffffff;
                                padding: 6px 10px;
                                text-align: left;
                                font-weight: 600;
                                border: 1px solid #2c3e50;
                            }
                            .cert-table th.text-center {
                                text-align: center;
                            }
                            .cert-table td {
                                padding: 5px 10px;
                                border: 1px solid #ccc;
                            }
                            .cert-table td.text-center {
                                text-align: center;
                            }
                            .cert-table tbody tr:nth-child(even) {
                                background-color: #f7f7f7;
                            }
                            .cert-table tfoot td {
                                background-color: #2c3e50;
                                color: #ffffff;
                                font-weight: 700;
                                border: 1px solid #2c3e50;
                            }
                            /* ---- Custom / Apostille boxes ---- */
                            .cert-custom-box {
                                border: 1px solid #bbb;
                                padding: 10px 14px;
                                margin-bottom: 14px;
                                font-size: 11px;
                            }
                            .cert-apostille-box {
                                border-left: 3px solid #2c3e50;
                                padding: 8px 14px;
                                margin-bottom: 14px;
                                font-size: 11px;
                                color: #444;
                            }
                            /* ---- Footer ---- */
                            .cert-footer {
                                margin-top: 30px;
                                font-size: 12px;
                                line-height: 1.6;
                            }
                            .cert-footer .cert-date-line {
                                margin-bottom: 28px;
                            }
                            .cert-footer .cert-signature-block {
                                display: inline-block;
                                text-align: center;
                                min-width: 260px;
                            }
                            .cert-footer .cert-signature-block .cert-sig-line {
                                border-top: 1px solid #1a1a1a;
                                width: 220px;
                                margin: 0 auto 6px auto;
                            }
                            .cert-footer .cert-signature-block img {
                                max-height: 40px;
                                margin-bottom: 4px;
                            }
                            .cert-footer .cert-signature-block .cert-dept {
                                font-weight: 700;
                                font-size: 11px;
                            }
                            .cert-footer .cert-signature-block .cert-inst {
                                font-size: 11px;
                                color: #333;
                            }
                            /* ---- Left marginal text ---- */
                            .cert-marginal {
                                position: fixed;
                                left: 4px;
                                top: 100px;
                                bottom: 60px;
                                writing-mode: vertical-rl;
                                transform: rotate(180deg);
                                font-size: 6.5px;
                                color: #999;
                                line-height: 1.2;
                                letter-spacing: 0.3px;
                            }
                        </style>

                        <div class="cert-page">
                            <!-- Left marginal legal text -->
                            <div class="cert-marginal">
                                Instituto Raimon Gaja, S.L. · NIF: B50588887 ·
                                Inscrita en el Registro Mercantil de Barcelona,
                                fecha 18/10/2023 · Folio 122 · Tomo 48.989
                            </div>

                            <!-- === Header: logo === -->
                            <div class="cert-header">
                                <t t-if="o.env.company.logo">
                                    <img t-att-src="image_data_uri(o.env.company.logo)" alt="Logo"/>
                                </t>
                            </div>

                            <!-- === Title === -->
                            <div class="cert-title">
                                <h1>Certificado de Calificaciones</h1>
                                <t t-if="o.certificate_type == 'physical_apostilled'">
                                    <p class="cert-subtitle">
                                        Sujeto a Apostilla de La Haya — <t t-out="o.env.company.name"/>
                                    </p>
                                </t>
                            </div>

                            <!-- === Body paragraph === -->
                            <div class="cert-body">
                                <p>
                                    El <strong>Instituto Raimon Gaja</strong> certifica que
                                    <strong><t t-out="o.partner_id.name or ''"/></strong>,
                                    con <strong><t t-out="id_type_name or 'DNI/Pasaporte'"/></strong>
                                    n.º <strong><t t-out="id_number"/></strong>,
                                    ha cursado el programa de estudios
                                    «<strong><t t-out="o.course_id.name or ''"/></strong>»
                                    habiendo obtenido las siguientes calificaciones:
                                </p>
                            </div>

                            <!-- === Grade table === -->
                            <table class="cert-table">
                                <thead>
                                    <tr>
                                        <th style="width: 12%;">Cód.</th>
                                        <th>Asignatura</th>
                                        <th class="text-center" style="width: 18%;">Calificación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="subjects" t-as="subj">
                                        <tr>
                                            <td><t t-out="subj.op_subject_id.code or ''"/></td>
                                            <td><t t-out="subj.op_subject_id.name or ''"/></td>
                                            <td class="text-center">
                                                <t t-out="'%.2f' % (subj.final_subject_note or 0.0)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2">Nota Media General</td>
                                        <td class="text-center">
                                            <t t-out="'%.2f' % (o.gradebook_student_id.total_final or 0.0)"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- === Custom description (only for type 'custom') === -->
                            <t t-if="o.certificate_type == 'custom' and o.custom_description">
                                <div class="cert-custom-box">
                                    <strong>Especificaciones adicionales:</strong><br/>
                                    <t t-out="o.custom_description"/>
                                </div>
                            </t>

                            <!-- === Apostille legal note === -->
                            <t t-if="o.certificate_type == 'physical_apostilled'">
                                <div class="cert-apostille-box">
                                    <strong>Nota legal:</strong>
                                    Este certificado está sujeto al trámite de legalización mediante la
                                    Apostilla de La Haya en virtud del Convenio de 5 de octubre de 1961.
                                    <t t-if="o.apostille_done">
                                        <br/><em>Apostilla tramitada ✓</em>
                                    </t>
                                </div>
                            </t>

                            <!-- === Footer === -->
                            <div class="cert-footer">
                                <p class="cert-date-line">
                                    Para que así conste, firmo la presente en Barcelona, a
                                    <t t-out="o.request_date.strftime('%d') if o.request_date else '__'"/> de
                                    <t t-out="{
                                        1: 'enero', 2: 'febrero', 3: 'marzo', 4: 'abril',
                                        5: 'mayo', 6: 'junio', 7: 'julio', 8: 'agosto',
                                        9: 'septiembre', 10: 'octubre', 11: 'noviembre', 12: 'diciembre'
                                    }.get(o.request_date.month, '') if o.request_date else '________'"/> de
                                    <t t-out="o.request_date.strftime('%Y') if o.request_date else '____'"/>.
                                </p>

                                <div class="cert-signature-block">
                                    <div class="cert-sig-line"> </div>
                                    <t t-if="o.env.company.logo">
                                        <img t-att-src="image_data_uri(o.env.company.logo)" alt="Logo"/>
                                    </t>
                                    <div class="cert-dept">Departamento Académico</div>
                                    <div class="cert-inst">Instituto Raimon Gaja</div>
                                </div>
                            </div>

                        </div><!-- .cert-page -->
                    </div><!-- .article -->
                </t><!-- t-foreach -->
            </t><!-- web.html_container -->
        </template>

    </data>
</odoo>
