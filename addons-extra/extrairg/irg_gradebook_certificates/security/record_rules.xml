<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Portal users can only read their own certificate requests -->
        <record id="rule_cert_request_portal_own" model="ir.rule">
            <field name="name">Certificate Request: Portal — solo registros propios</field>
            <field name="model_id" ref="model_irg_certificate_request"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Internal users see all records (no domain restriction needed,
             but we explicitly state it to be clear) -->
        <record id="rule_cert_request_internal_all" model="ir.rule">
            <field name="name">Certificate Request: Internos — todos los registros</field>
            <field name="model_id" ref="model_irg_certificate_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
