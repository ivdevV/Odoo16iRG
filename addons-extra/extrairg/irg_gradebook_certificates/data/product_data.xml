<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: prices are administrative — updates won't reset them -->
    <data noupdate="1">

        <!-- ============================================================
             Main certificate products (not published in shop)
        ============================================================ -->

        <record id="product_cert_digital" model="product.template">
            <field name="name">Certificado de Notas Digital</field>
            <field name="type">service</field>
            <field name="list_price">30.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="is_published" eval="False"/>
            <field name="description_sale">Certificado de notas en formato digital (PDF).</field>
        </record>

        <record id="product_cert_physical" model="product.template">
            <field name="name">Certificado de Notas Físico</field>
            <field name="type">service</field>
            <field name="list_price">40.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="is_published" eval="False"/>
            <field name="description_sale">Certificado de notas en formato físico (impreso y sellado).</field>
        </record>

        <record id="product_cert_custom" model="product.template">
            <field name="name">Certificado de Notas a Medida</field>
            <field name="type">service</field>
            <field name="list_price">40.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="is_published" eval="False"/>
            <field name="description_sale">Certificado de notas con especificaciones personalizadas.</field>
        </record>

        <record id="product_cert_apostilled" model="product.template">
            <field name="name">Certificado de Notas Físico Apostillado</field>
            <field name="type">service</field>
            <field name="list_price">120.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="is_published" eval="False"/>
            <field name="description_sale">Certificado de notas físico con trámite de Apostilla de La Haya.</field>
        </record>

        <!-- ============================================================
             Shipping supplement products
        ============================================================ -->

        <record id="product_shipping_national" model="product.template">
            <field name="name">Envío Nacional — Certificado</field>
            <field name="type">service</field>
            <field name="list_price">20.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="is_published" eval="False"/>
            <field name="description_sale">Suplemento de envío nacional para certificado físico.</field>
        </record>

        <record id="product_shipping_international" model="product.template">
            <field name="name">Envío Internacional — Certificado</field>
            <field name="type">service</field>
            <field name="list_price">60.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="is_published" eval="False"/>
            <field name="description_sale">Suplemento de envío internacional para certificado físico.</field>
        </record>

    </data>
</odoo>
