<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="irg_language_selector" name="IRG Language Selector">
        <t t-set="langs" t-value="(request.website.get_languages() if request and request.website else [])"/>
        <div class="language-selector irg-language-selector dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span>Idioma</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <!-- Force Spanish then English first -->
                <t t-foreach="langs" t-as="l">
                    <t t-if="l.get('code') == 'es'">
                        <li><a class="dropdown-item" t-att-href="'?lang=' + l.get('code')"> <t t-esc="l.get('name') or l.get('code')"/></a></li>
                    </t>
                </t>
                <t t-foreach="langs" t-as="l">
                    <t t-if="l.get('code') == 'en'">
                        <li><a class="dropdown-item" t-att-href="'?lang=' + l.get('code')"> <t t-esc="l.get('name') or l.get('code')"/></a></li>
                    </t>
                </t>
                <!-- Rest of languages -->
                <t t-foreach="langs" t-as="l">
                    <t t-if="l.get('code') not in ['es','en']">
                        <li><a class="dropdown-item" t-att-href="'?lang=' + l.get('code')"> <t t-esc="l.get('name') or l.get('code')"/></a></li>
                    </t>
                </t>
            </ul>
        </div>
    </template>

    <!-- The language selector is called directly from theme_silon/views/header.xml.
         No XPath inheritance needed here. -->
</odoo>
