<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stripe.subscriptions</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='sale_management']" position="inside">
                <h2>Integración de Suscripciones Stripe</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="stripe_api_key"/>
                            <div class="text-muted">
                                Clave Secreta de Stripe API (sk_...)
                            </div>
                            <div class="content-group">
                                <field name="stripe_api_key" password="True"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="stripe_publishable_key"/>
                            <div class="text-muted">
                                Clave Pública de Stripe API (pk_...)
                            </div>
                            <div class="content-group">
                                <field name="stripe_publishable_key"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="stripe_webhook_secret"/>
                            <div class="text-muted">
                                Secreto de Firma del Webhook de Stripe (whsec_...)
                            </div>
                            <div class="content-group">
                                <field name="stripe_webhook_secret" password="True"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="stripe_api_version"/>
                            <div class="text-muted">
                                Versión fija de API Stripe utilizada
                            </div>
                            <div class="content-group">
                                <field name="stripe_api_version"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
