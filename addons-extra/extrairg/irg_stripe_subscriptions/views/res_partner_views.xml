<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_stripe" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.stripe</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Stripe" name="stripe_integration">
                    <group string="Identificación de Stripe">
                        <field name="stripe_customer_id" readonly="1"/>
                    </group>
                    <group string="Suscripciones Stripe">
                        <field name="stripe_subscription_ids" nolabel="1" readonly="1">
                            <tree>
                                <field name="name"/>
                                <field name="stripe_id"/>
                                <field name="status" widget="badge"
                                       decoration-success="status in ('active', 'trialing')" 
                                       decoration-warning="status in ('past_due', 'paused', 'incomplete')" 
                                       decoration-danger="status in ('canceled', 'incomplete_expired', 'unpaid')"/>
                                <field name="amount"/>
                                <field name="interval"/>
                                <field name="current_period_end"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Enlaces de Pago Stripe">
                        <field name="stripe_payment_link_ids" nolabel="1">
                            <tree edit="false" create="false">
                                <field name="name"/>
                                <field name="stripe_id"/>
                                <field name="url" widget="url"/>
                                <field name="active" widget="boolean_toggle"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
