<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_gender" model="ir.ui.view">
        <field name="name">sale.order.form.irg.gender</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="isep_openeducat_sale.view_sale_order_form_website_sale"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sale_admission']//field[@name='admission_date']" position="before">
                <field name="gender"/>
            </xpath>
        </field>
    </record>
</odoo>
