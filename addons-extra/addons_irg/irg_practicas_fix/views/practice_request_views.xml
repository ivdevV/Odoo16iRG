<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario mejorada - hereda y modifica la original -->
    <record id="view_practice_request_form_fix" model="ir.ui.view">
        <field name="name">practice.request.form.fix</field>
        <field name="model">practice.request</field>
        <field name="inherit_id" ref="isep_practices_2.view_practice_request_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Reemplazar el campo user_id para hacerlo editable y sin restricciones -->
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            
            <!-- Mostrar op_student_id después de user_id (readonly porque es computado) -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="op_student_id" readonly="1" string="Estudiante"/>
            </xpath>
            
            <!-- Ocultar el op_student_id invisible original -->
            <xpath expr="//field[@name='op_student_id' and @invisible]" position="replace">
            </xpath>
            
            <!-- Modificar op_admission_id para filtrar por estudiante -->
            <xpath expr="//field[@name='op_admission_id']" position="replace">
                <field name="op_admission_id" 
                       domain="[('student_id', '=', op_student_id)]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            
            <!-- Agregar dominio al campo course_id para filtrar por estudiante -->
            <xpath expr="//field[@name='course_id']" position="replace">
                <field name="course_id" 
                       domain="[('student_id', '=', op_student_id)]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
