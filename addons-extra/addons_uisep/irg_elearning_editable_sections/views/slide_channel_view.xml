<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_channel_form_editable_sections" model="ir.ui.view">
        <field name="name">slide.channel.form.editable.sections.irg</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='content']//field[@name='slide_ids']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//notebook/page[@name='content']//field[@name='slide_ids']//tree//field[@name='name']" position="after">
                <field name="is_category" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="parent_slide_id" optional="show"/>
                <field name="inherit_limitations_from_parent" optional="show"/>
                <field name="scheduled_date" optional="show"/>
                <field name="allowed_batch_ids" widget="many2many_tags" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
