<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Wizard Form View -->
    <record id="view_admission_csv_export_wizard_form" model="ir.ui.view">
        <field name="name">admission.csv.export.wizard.form</field>
        <field name="model">admission.csv.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Admisiones a CSV">
                <group attrs="{'invisible': [('state', '=', 'done')]}">
                    <group>
                        <field name="admission_count" readonly="1" string="Admisiones seleccionadas"/>
                    </group>
                    <group>
                        <p>Se exportarán las admisiones seleccionadas a un archivo CSV.</p>
                    </group>
                </group>
                <group attrs="{'invisible': [('state', '=', 'choose')]}">
                    <group>
                        <field name="csv_file" filename="csv_filename" readonly="1"/>
                        <field name="csv_filename" invisible="1"/>
                    </group>
                    <group>
                        <p>El archivo CSV ha sido generado correctamente. Haga clic en el enlace para descargarlo.</p>
                    </group>
                </group>
                <field name="state" invisible="1"/>
                <field name="admission_ids" invisible="1"/>
                <footer>
                    <button name="action_export_csv" string="Exportar CSV" type="object" class="btn-primary" attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action to open wizard from op.admission (tree view - multiple selection) -->
    <record id="action_admission_csv_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportar a CSV</field>
        <field name="res_model">admission.csv.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="openeducat_admission.model_op_admission"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
