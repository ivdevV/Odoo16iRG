<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_slide_form_prerequisite" model="ir.ui.view">
        <field name="name">slide.slide.form.prerequisite</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <!-- ESTRATEGIA SEGURA: Usar solo la pestaña nueva -->
            <!-- Los grupos 'slide_details' y 'slide_statistics' no existen en la vista padre original -->
            <!-- o han sido eliminados por otro módulo, por eso falló el xpath anterior -->
            
            <xpath expr="//notebook" position="inside">
                <page string="Prerrequisitos (iRG)" name="prerequisites_irg">
                    <group>
                        <field name="prerequisite_slide_id" domain="[('channel_id', '=', channel_id), ('id', '!=', id)]"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- AÑADIDO: Mostrar columna en la lista de contenidos del curso -->
    <record id="view_slide_channel_form_prerequisite" model="ir.ui.view">
        <field name="name">slide.channel.form.prerequisite</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='content']//field[@name='slide_ids']//tree//field[@name='name']" position="after">
                <field name="prerequisite_slide_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
