<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_line_tree_student" model="ir.ui.view">
        <field name="name">sale.order.line.tree.student</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="isep_openeducat_sale.sale_order_line_tree"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='order_partner_id']" position="after">
                <field name="student_id" optional="show"/>
             </xpath>
        </field>
    </record>
</odoo>
