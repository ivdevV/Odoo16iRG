<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Override product price to show monthly installment -->
    <template id="product_price_monthly" inherit_id="website_sale.product_price" priority="100">
        <xpath expr="//span[hasclass('oe_price')]" position="replace">
            <t t-set="selected_months" t-value="combination_info.get('months', 1)"/>
            <t t-set="selected_price" t-value="combination_info.get('price', 0.0)"/>
            <t t-set="display_price" t-value="selected_price / selected_months if selected_months &gt; 1 else selected_price"/>

            <t t-if="display_price">
                <span class="oe_price" style="white-space: nowrap;" t-esc="display_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <span class="text-muted isep_month_suffix" style="font-size: 0.8rem;" t-if="selected_months > 1">
                    <t t-esc="' / %s meses' % selected_months"/>
                </span>
                <span id="isep_monthly_price_active" style="display:none;" t-att-data-months="selected_months">Active-Selected-Installment</span>
            </t>
            <t t-else="">
                <span class="oe_price" style="white-space: nowrap;" t-esc="combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <span id="isep_monthly_price_active" style="display:none;" t-att-data-months="combination_info.get('months', 1)">Active-Single</span>
            </t>
        </xpath>
        <xpath expr="//span[hasclass('mb-3') and hasclass('o_website_sale_subscription_pricing_id')]" position="replace"/>
    </template>

    <!-- Cart Lines Override -->
    <template id="cart_lines_monthly" inherit_id="website_sale.cart_lines" priority="100">
        <xpath expr="//td[hasclass('td-price')]/span" position="replace">
            <t t-set="months" t-value="1"/>
            <t t-foreach="line.product_id.product_template_attribute_value_ids" t-as="ptav">
                <t t-if="ptav.attribute_id.name.lower() == 'planes'">
                    <t t-if="ptav.plazo > 0">
                        <t t-set="months" t-value="ptav.plazo"/>
                    </t>
                    <t t-elif="ptav.name and 'mes' in ptav.name.lower()">
                         <!-- Simple parsing for XML fallback - ORDER MATTERS (Longer first) -->
                         <t t-if="'25' in ptav.name"><t t-set="months" t-value="25"/></t>
                         <t t-elif="'24' in ptav.name"><t t-set="months" t-value="24"/></t>
                         <t t-elif="'19' in ptav.name"><t t-set="months" t-value="19"/></t>
                         <t t-elif="'18' in ptav.name"><t t-set="months" t-value="18"/></t>
                         <t t-elif="'13' in ptav.name"><t t-set="months" t-value="13"/></t>
                         <t t-elif="'12' in ptav.name"><t t-set="months" t-value="12"/></t>
                         <t t-elif="'9' in ptav.name"><t t-set="months" t-value="9"/></t>
                         <t t-elif="'7' in ptav.name"><t t-set="months" t-value="7"/></t>
                         <t t-elif="'6' in ptav.name"><t t-set="months" t-value="6"/></t>
                         <t t-elif="'3' in ptav.name"><t t-set="months" t-value="3"/></t>
                    </t>
                </t>
            </t>
            
            <!-- Fallback: Parse line name if attributes failed -->
            <t t-if="months == 1 and line.name_short and 'mes' in line.name_short.lower()">
                 <t t-if="'25' in line.name_short"><t t-set="months" t-value="25"/></t>
                 <t t-elif="'24' in line.name_short"><t t-set="months" t-value="24"/></t>
                 <t t-elif="'19' in line.name_short"><t t-set="months" t-value="19"/></t>
                 <t t-elif="'18' in line.name_short"><t t-set="months" t-value="18"/></t>
                 <t t-elif="'13' in line.name_short"><t t-set="months" t-value="13"/></t>
                 <t t-elif="'12' in line.name_short"><t t-set="months" t-value="12"/></t>
                 <t t-elif="'9' in line.name_short"><t t-set="months" t-value="9"/></t>
                 <t t-elif="'7' in line.name_short"><t t-set="months" t-value="7"/></t>
                 <t t-elif="'6' in line.name_short"><t t-set="months" t-value="6"/></t>
                 <t t-elif="'3' in line.name_short"><t t-set="months" t-value="3"/></t>
            </t>
            
            <t t-if="months > 1">
                <span t-esc="line.price_reduce_taxexcl / months" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" groups="account.group_show_line_subtotals_tax_excluded" />
                <span t-esc="line.price_reduce_taxinc / months" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" groups="account.group_show_line_subtotals_tax_included" />
                <span class="text-muted" style="font-size: 0.8rem;"> / mes</span>
            </t>
            <t t-else="">
                <span t-field="line.price_reduce_taxexcl" style="white-space: nowrap;" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" groups="account.group_show_line_subtotals_tax_excluded" />
                <span t-field="line.price_reduce_taxinc" style="white-space: nowrap;" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" groups="account.group_show_line_subtotals_tax_included" />
            </t>
        </xpath>
        
        <!-- Remove standard subscription unit display to avoid duplication -->
        <xpath expr="//td[hasclass('td-price')]/div[@t-if=&quot;line.temporal_type == 'subscription'&quot;]" position="replace">
            <!-- Removed by isep_website_sale_monthly_price -->
        </xpath>
    </template>


    <!-- Cart Popover Override -->
    <template id="cart_popover_monthly" inherit_id="website_sale.cart_popover" priority="100">
        <xpath expr="//div[hasclass('col-9')]" position="inside">
            <div class="mt-1">
                <!-- Prefer server-canonical minimum installment if available for this product template -->
                <t t-set="min_data" t-value="line.product_id.product_tmpl_id._isep_get_min_installment_data(website.get_current_website().get_current_pricelist())"/>
                <t t-set="min_installment_price" t-value="min_data and min_data[0] or False"/>
                <t t-set="min_installment_months" t-value="min_data and min_data[1] or 1"/>

                <t t-if="min_installment_price">
                    <span class="oe_price" t-esc="min_installment_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    <span class="text-muted" style="font-size: 0.8rem;" t-if="min_installment_months &gt; 1"> / <t t-esc="min_installment_months"/> meses</span>
                </t>
                <t t-else="">
                    <!-- Fallback to legacy per-line parsing when canonical value unavailable -->
                    <t t-set="months" t-value="1"/>
                    <t t-foreach="line.product_id.product_template_attribute_value_ids" t-as="ptav">
                        <t t-if="ptav.attribute_id.name.lower() == 'planes'">
                            <t t-if="ptav.plazo > 0">
                                <t t-set="months" t-value="ptav.plazo"/>
                            </t>
                            <t t-elif="ptav.name and 'mes' in ptav.name.lower()">
                                 <t t-if="'25' in ptav.name"><t t-set="months" t-value="25"/></t>
                                 <t t-elif="'24' in ptav.name"><t t-set="months" t-value="24"/></t>
                                 <t t-elif="'19' in ptav.name"><t t-set="months" t-value="19"/></t>
                                 <t t-elif="'18' in ptav.name"><t t-set="months" t-value="18"/></t>
                                 <t t-elif="'13' in ptav.name"><t t-set="months" t-value="13"/></t>
                                 <t t-elif="'12' in ptav.name"><t t-set="months" t-value="12"/></t>
                                 <t t-elif="'9' in ptav.name"><t t-set="months" t-value="9"/></t>
                                 <t t-elif="'7' in ptav.name"><t t-set="months" t-value="7"/></t>
                                 <t t-elif="'6' in ptav.name"><t t-set="months" t-value="6"/></t>
                                 <t t-elif="'3' in ptav.name"><t t-set="months" t-value="3"/></t>
                            </t>
                        </t>
                    </t>
                    <t t-if="months &gt; 1">
                        <span t-esc="line.price_reduce_taxexcl / months" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <span class="text-muted" style="font-size: 0.8rem;"> / mes</span>
                    </t>
                    <t t-else="">
                        <span t-field="line.price_reduce_taxexcl" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    </t>
                </t>
            </div>
        </xpath>
    </template>

    <!-- Product listing: prefer server-calculated canonical min_installment when available -->
    <template id="products_item_min_installment" inherit_id="website_sale.products_item" priority="120">
        <xpath expr="//div[hasclass('product_price')]" position="replace">
            <div class="product_price">
            <t t-set="product_tmpl" t-value="product if product._name == 'product.template' else product.product_tmpl_id"/>
            <t t-set="min_data" t-value="product_tmpl._isep_get_min_installment_data(website.get_current_website().get_current_pricelist())"/>
            <t t-set="min_installment_price" t-value="min_data and min_data[0] or False"/>
            <t t-set="min_installment_months" t-value="min_data and min_data[1] or 1"/>
            <t t-set="display_currency" t-value="template_price_vals.get('display_currency') or website.currency_id"/>

            <t t-if="min_installment_price">
                <span class="oe_price" style="white-space: nowrap;" t-esc="min_installment_price" t-options="{'widget': 'monetary', 'display_currency': display_currency}"/>
                <span class="text-muted isep_month_suffix" style="font-size: 0.8rem;" t-if="min_installment_months > 1">
                    <t t-esc="' / %s meses' % min_installment_months"/>
                </span>
            </t>
            <t t-else="">
                <span class="oe_price" style="white-space: nowrap;" t-esc="template_price_vals['price']" t-options="{'widget': 'monetary', 'display_currency': display_currency}"/>
            </t>
            </div>
        </xpath>
    </template>
</odoo>
