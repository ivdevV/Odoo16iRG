                 <t t-elif="'19' in line.name_short"><t t-set="months" t-value="19"/></t>
                 <t t-elif="'24' in line.name_short"><t t-set="months" t-value="24"/></t>
                 <t t-elif="'25' in line.name_short"><t t-set="months" t-value="25"/></t>
            </t>
            
            <t t-if="months > 1">
                <span t-esc="line.price_reduce_taxexcl / months" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" groups="account.group_show_line_subtotals_tax_excluded" />
                <span t-esc="line.price_reduce_taxinc / months" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" groups="account.group_show_line_subtotals_tax_included" />
                <span class="text-muted" style="font-size: 0.8rem;"> / mes</span>
            </t>
            <t t-else="">
                <span t-field="line.price_reduce_taxexcl" style="white-space: nowrap;" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" groups="account.group_show_line_subtotals_tax_excluded" />
                <span t-field="line.price_reduce_taxinc" style="white-space: nowrap;" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" groups="account.group_show_line_subtotals_tax_included" />
            </t>
        </xpath>
        
        <!-- Remove standard subscription unit display to avoid duplication -->
        <xpath expr="//td[hasclass('td-price')]/div[@t-if=&quot;line.temporal_type == 'subscription'&quot;]" position="replace">
            <!-- Removed by isep_website_sale_monthly_price -->
        </xpath>
    </template>

    <!-- Cart Popover Override -->
    <template id="cart_popover_monthly" inherit_id="website_sale.cart_popover" priority="100">
        <xpath expr="//div[hasclass('col-9')]" position="inside">
            <div class="mt-1">
                <t t-set="months" t-value="1"/>
                <t t-foreach="line.product_id.product_template_attribute_value_ids" t-as="ptav">
                    <t t-if="ptav.attribute_id.name.lower() == 'planes'">
                        <t t-if="ptav.plazo > 0">
                            <t t-set="months" t-value="ptav.plazo"/>
                        </t>
                        <t t-elif="ptav.name and 'mes' in ptav.name.lower()">
                             <t t-if="'3' in ptav.name"><t t-set="months" t-value="3"/></t>
                             <t t-elif="'6' in ptav.name"><t t-set="months" t-value="6"/></t>
                             <t t-elif="'9' in ptav.name"><t t-set="months" t-value="9"/></t>
                             <t t-elif="'12' in ptav.name"><t t-set="months" t-value="12"/></t>
                             <t t-elif="'13' in ptav.name"><t t-set="months" t-value="13"/></t>
                             <t t-elif="'18' in ptav.name"><t t-set="months" t-value="18"/></t>
                             <t t-elif="'19' in ptav.name"><t t-set="months" t-value="19"/></t>
                             <t t-elif="'24' in ptav.name"><t t-set="months" t-value="24"/></t>
                             <t t-elif="'25' in ptav.name"><t t-set="months" t-value="25"/></t>
                        </t>
                    </t>
                </t>
                
                <t t-if="months > 1">
                    <span t-esc="line.price_reduce_taxexcl / months" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    <span class="text-muted" style="font-size: 0.8rem;"> / mes</span>
                </t>
                <t t-else="">
                    <span t-field="line.price_reduce_taxexcl" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
