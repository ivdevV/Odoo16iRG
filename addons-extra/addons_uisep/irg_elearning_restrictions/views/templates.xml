<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="slide_restriction_error" name="Slide Restriction Error">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading">Contenido Bloqueado</h4>
                    <p>
                        Para acceder a este contenido (<strong><t t-esc="slide.name"/></strong>),
                        primero debes completar los siguientes requisitos:
                    </p>
                    <ul class="mb-3">
                        <t t-foreach="prerequisites" t-as="prereq">
                            <li>
                                <a t-att-href="'/slides/slide/%s' % prereq.id">
                                    <t t-esc="prereq.name"/>
                                </a>
                            </li>
                        </t>
                    </ul>
                    <hr/>
                    <p class="mb-0">
                        <a t-att-href="'/slides/%s' % slide.channel_id.id" class="btn btn-secondary">
                            Volver al curso
                        </a>
                    </p>
                </div>
            </div>
        </t>
    </template>

    <template id="slide_access_blocked" name="Slide Access Blocked by Debt Tag">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Acceso restringido</h4>
                    <p>
                        Tu usuario tiene una restricción administrativa y no puede acceder a los materiales del campus en este momento.
                    </p>
                    <hr/>
                    <p class="mb-0">Por favor, contacta con Atención al Alumno para regularizar tu situación.</p>
                </div>
            </div>
        </t>
    </template>
    <template id="slide_fullscreen_sidebar_restriction"
              inherit_id="website_slides.slide_fullscreen_sidebar_category"
              name="Sidebar: marcar como no accesibles los slides con prerrequisitos pendientes"
              priority="99">
        <!-- Añadee un t-set DESPUÉS del original para sobreescribir can_access
             cuando el slide tiene prerrequisitos pendientes.
             restricted_slide_ids es un set inyectado por WebsiteSlidesCustom._get_slide_detail ok-->
        <xpath expr="//t[@t-set='can_access']" position="after">
            <t t-if="restricted_slide_ids and slide.id in restricted_slide_ids"
               t-set="can_access" t-value="False"/>
        </xpath>
        <xpath expr="//li[contains(@t-attf-class,'o_wslides_fs_sidebar_list_item')]" position="attributes">
            <attribute name="t-att-data-embed-code">False if restricted_slide_ids and slide.id in restricted_slide_ids else slide.embed_code if slide.slide_category in ['video', 'document', 'infographic', 'local_external', 'bunny', 'scorm'] else False</attribute>
        </xpath>
    </template>
</odoo>
