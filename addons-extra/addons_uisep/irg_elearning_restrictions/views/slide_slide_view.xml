<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_slide_form_restriction" model="ir.ui.view">
        <field name="name">slide.slide.form.restriction</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <!-- ESTRATEGIA: Prioridad Alta (999) para vencer a Odoo Studio -->
            <xpath expr="//page[@name='quiz']" position="inside">
                <group string="Test Visibility (iRG) - Quiz Tab">
                    <field name="test_visibility_field"/>
                </group>
            </xpath>

            <!-- RESPALDO: Insertar también en la pestaña Documento -->
            <xpath expr="//page[@name='document']" position="inside">
                <group string="Test Visibility (iRG) - Document Tab">
                    <field name="test_visibility_field"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- FIX: Forzar que el campo slide_ids en el canal use la vista de formulario estándar -->
    <record id="view_slide_channel_form_restriction" model="ir.ui.view">
        <field name="name">slide.channel.form.restriction</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="priority" eval="2000"/>
        <field name="arch" type="xml">
            <!-- DEBUG: Verificar que esta vista se está cargando -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="display_name" string="VISTA CARGADA OK" readonly="1"/>
            </xpath>

            <!-- NUCLEAR OPTION: Reemplazar el campo slide_ids completo -->
            <!-- Esto elimina cualquier formulario inline (Studio) y fuerza el uso de la vista externa -->
            <xpath expr="//page[@name='content']//field[@name='slide_ids']" position="replace">
                <field name="slide_ids" context="{'default_channel_id': active_id, 'form_view_ref': 'website_slides.view_slide_slide_form'}">
                    <tree>
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                        <field name="slide_category"/>
                        <field name="duration" widget="float_time"/>
                        <field name="total_views"/>
                        <field name="is_preview"/>
                        <field name="is_published" widget="boolean_toggle"/>
                        <field name="test_visibility_field" optional="show" string="Test Columna"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>

    <!-- PRUEBA 2: Insertar en la vista de lista (Tree) para confirmar que el campo existe -->
    <record id="view_slide_slide_tree_restriction" model="ir.ui.view">
        <field name="name">slide.slide.tree.restriction</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="test_visibility_field" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
