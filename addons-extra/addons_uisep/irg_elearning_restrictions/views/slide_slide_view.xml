<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_slide_form_restriction" model="ir.ui.view">
        <field name="name">slide.slide.form.restriction</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <!-- DEBUG: Insertar campo en el encabezado para verificar que la vista se carga -->
            <xpath expr="//field[@name='slide_category']" position="after">
                <field name="test_visibility_field" readonly="1"/>
            </xpath>

            <!-- ESTRATEGIA: Insertar ANTES de la descripción, que es una pestaña estándar -->
            <xpath expr="//notebook/page[@name='description']" position="before">
                <page string="TEST VISIBILIDAD" name="test_visibility_page">
                    <group>
                        <field name="test_visibility_field" placeholder="Si ves esto, funciona"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- PRUEBA 2: Insertar en la vista de lista (Tree) para confirmar que el campo existe -->
    <record id="view_slide_slide_tree_restriction" model="ir.ui.view">
        <field name="name">slide.slide.tree.restriction</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="test_visibility_field" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
