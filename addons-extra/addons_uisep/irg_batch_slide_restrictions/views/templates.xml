<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="slide_fullscreen_sidebar_batch_hide"
              inherit_id="website_slides.slide_fullscreen_sidebar_category"
              name="Sidebar: ocultar slides restringidos por lote">
        <!-- Oculta completamente el <li> de la sidebar cuando el slide está
             bloqueado por lote para el alumno (batch_blocked_slide_ids es un set
             inyectado por WebsiteSlidesBatchRestrictions._get_slide_detail). -->
        <xpath expr="//li[contains(@t-attf-class,'o_wslides_fs_sidebar_list_item')]" position="attributes">
            <attribute name="t-if">not (batch_blocked_slide_ids and slide.id in batch_blocked_slide_ids)</attribute>
        </xpath>
    </template>

    <template id="slide_batch_restriction_error" name="Slide Batch Restriction Error">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading">Contenido Bloqueado</h4>
                    <p>
                        El contenido <strong><t t-esc="slide.name"/></strong> no está habilitado
                        para tu lote actual.
                    </p>
                    <hr/>
                    <p class="mb-0">
                        <a t-att-href="slide.channel_id.website_url" class="btn btn-primary">
                            Volver a la asignatura
                        </a>
                    </p>
                </div>
            </div>
        </t>
    </template>
</odoo>
