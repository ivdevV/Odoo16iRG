<odoo>
    <data noupdate="0" >
         <record id='cron_payment_segmentada_transaction_custom' model='ir.cron'>
            <field name='name'>[NUEVO] Suscripciones: Cobro sobre factura pendiente Segmentada</field>
            <field name='model_id' ref='model_payment_transaction'/>
            <field name='state'>code</field>
            <field name='code'># model._cron_recurring_payment_sale_order(meses=11, previsualizar=True, pendiente=100, conpany_all=False)
                # meses: cantidad de facturas con meses hacia atras de vencimiento, se aplica al filtro
                # previsualizar: True o False, True para visualizar que facturas intentara cobrar y False para cobrar
                # pendiente: es un valor en porcentaje, pretederminado en 100 para que intente cobrar el 100% de la deuda, puede variar con otros valores como 10, 20, 50, etc
                # conpany_all: Valor en False respeta que el token a usar en la factura sean de la misma empresa, el valor True necesitara de conciliacion manual en caso de exito en cobro.
            </field>
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name='numbercall'>-1</field>
            <field name='active'>0</field>
        </record>

        <record id='ir_cron_clean_payment_retry_logs' model='ir.cron'>
            <field name='name'>[Pago] Limpiar registros antiguos de reintentos</field>
            <field name='model_id' ref='model_payment_retry_log'/>
            <field name='state'>code</field>
            <field name='code'># model._cron_clean_old_logs(days=30, previsualizar=True)</field>
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name='numbercall'>-1</field>
            <field name='active'>0</field>
        </record>

