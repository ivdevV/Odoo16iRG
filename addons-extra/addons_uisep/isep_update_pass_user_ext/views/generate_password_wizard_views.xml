<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generate_password_wizard_form" model="ir.ui.view">
        <field name="name">isep.generate.password.wizard.form</field>
        <field name="model">isep.generate.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Contraseña actualizada" create="0" edit="0" delete="0">
                <group>
                    <field name="user_id" readonly="1"/>
                    <field name="generated_password" readonly="1" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button string="Cerrar" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
