<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_intensivo_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.intensivo.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="irg_is_intensive" widget="boolean_toggle"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="after">
                <field name="irg_is_intensive" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
