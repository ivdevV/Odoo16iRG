<odoo>

        <record id="op_admission_tree" model="ir.ui.view">
            <field name="name">op.admission.tree</field>
            <field name="model">op.admission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="Registration">
                    <field name="student_id" string="Estudiante"/>
                    <field name="generation" string="Generación"/>
                    <field name="course_id" string="Curso"/>
                    <field name="admission_status" string="Estatus Oficialidad"/>
                    <field name="accepted_percentpie"  string="Documentos Completos" widget="progressbar"/>
                    <field name="batch_id"  string="Grupo" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                    <field name="state" optional="show"/>
                </tree>
            </field>
        </record>
        <record id="op_admission_tree_gen" model="ir.ui.view">
            <field name="name">op.admission.tree.gen</field>
            <field name="model">op.admission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="Lot and Generation" decoration-warning="pending_payments">
                    <header>
                        <button name="action_generate_student_report" type="object" string="Generar Anexo 8"/>
                    </header>
                    <field name="student_id" string="Estudiante"/>
                    <field name="generation" string="Generación"/>
                    <field name="course_id" string="Curso"/>
                    <field name="batch_id"  string="Grupo" optional="hide"/>
                    <field name="admission_status" string="Estatus Oficialidad"/>
                    <field name="accepted_percentpie"  string="Documentos Completos" widget="progressbar"/>
                    <field name="student_report_id" optional="show" widget="many2onebutton"/>
                    <field name="student_report_state" optional="show"/>
                    <field name="pending_payments"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="state" optional="show"/>
                </tree>
            </field>
        </record>

 
        <record id="op_admission_form" model="ir.ui.view">
            <field name="name">op.admission.form</field>
            <field name="model">op.admission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Registration">
                    <header>
                        <button string="Submit" states="draft" class="oe_highlight" type="object" name="submit_form"/>
                        <button name="confirm_in_progress" states="submit,pending" string="Confirm" type="object"
                                class="oe_highlight"/>
                        <button string="Admission Confirm" class="oe_highlight" states="confirm" type="object"
                                name="admission_confirm"/>
                        <button name="enroll_student" states="admission" string="Enroll" type="object"
                                class="oe_highlight"/>
                        <button name="confirm_rejected" states="confirm,confirm_pending" string="Reject" type="object"/>
                        <button name="confirm_pending" states="submit" string="Pending" type="object"/>
                        <button name="confirm_cancel" string="Cancel" type="object"/>
                        <button name="confirm_to_draft" states="pending,reject,cancel" string="Set to Draft"
                                type="object"/>
                        <button name="open_student" states="done" string="Open Student Profile" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>

                        <field name="image" widget="image" class="oe_left oe_avatar"/>
                        <div class="oe_title">
                            <h3>
                                <field name="title" placeholder="Title" style="width: 30%%"/>
                            </h3>
                            <h2>
                                <field name="name" placeholder="Name" required="1" style="padding-right:10px"
                                       invisible="1"/>
                                <table>
                                    <tr>
                                        <td>
                                            <field name="first_name" placeholder="First Name" required="1"
                                                   style="padding-right:10px"
                                                   attrs="{'readonly': [('state', '=', 'done')]}"/>
                                        </td>
                                        <td>
                                            <field name="middle_name" placeholder="Middle Name"
                                                   style="padding-right:10px"/>
                                        </td>
                                        <td>
                                            <field name="last_name" placeholder="Last Name" required="1"
                                                   style="padding-right:10px"/>
                                        </td>
                                    </tr>
                                </table>
                            </h2>
                        </div>
                        <notebook>
                            <page name="admission_detail" string="Admission Detail">
                                <group>
                                    <group>
                                        <field name="register_id"
                                               domain="[('state', 'in', ['application','admission'])]"
                                               widget="selection"/>
                                        <field name="application_date"/>
                                        <field name="course_id"/>
                                        <field name="discount"/>
                                        <field name="due_date"/>
                                        <field name="is_student"/>
                                        <field name="company_id" groups="base.group_multi_company" optional="show"/>
                                        <field name="fees_start_date"/>
                                        <field name="order_id"/>
                                    </group>
                                    <group>
                                        <field name="application_number"/>
                                        <field name="admission_date"/>
                                        <field name="batch_id"
                                               context="{'course_id': course_id,'get_parent_batch':1}"/>
                                        <field name="fees"
                                               attrs="{'required': [('state','not in', ['draft', 'submit'])]}"/>
                                        <field name="fees_term_id" required="1"
                                               attrs="{'readonly': [('state','not in', ['draft', 'submit', 'confirm'])]}"/>
                                        <field name="partner_id"/>
                                        <field name="accepted_percentpie" widget="percentpie"/>
                                        <field name="student_id" placeholder="Student"
                                               options="{'no_create_edit': True}"
                                               attrs="{'required':[('is_student','=',True)],'invisible': [('is_student','=', False)]}"/>
                                    </group>
                                </group>
                            </page>
                            <page name="educational_detail" string="Educational Detail">
                                <group>
                                    <group>
                                        <field name="prev_institute_id"/>
                                        <field name="prev_result"/>
                                    </group>
                                    <group>
                                        <field name="prev_course_id"/>
                                    </group>
                                </group>
                            </page>
                            <page name="personal_detail" string="Personal Detail">
                                <group>
                                    <group>
                                        <field name="gender"/>
                                        <field name="email" placeholder="Email"/>
                                    </group>
                                    <group>
                                        <field name="birth_date" options="{'datepicker':{'warn_future': true}}"/>
                                    </group>
                                </group>
                                <label for="street" string="Address"/>
                                <div>
                                    <div>
                                        <field name="street" placeholder="Street..." nolabel="1" style="width: 100%%"/>
                                        <field name="street2" placeholder="Street 2..." nolabel="1"
                                               style="width: 100%%"/>
                                    </div>
                                    <div class="address_format">
                                        <field name="city" placeholder="City" style="width: 40%%"/>
                                        <field name="state_id" options='{"no_open": True}'
                                               placeholder="State" style="width: 24%%"/>
                                        <field name="zip" placeholder="ZIP" style="width: 34%%"/>
                                    </div>
                                    <div>
                                        <field name="country_id" placeholder="Country" options='{"no_open": True}'
                                               nolabel="1"/>
                                        <field name="phone" placeholder="Phone" nolabel="1" style="width: 100%%"/>
                                        <field name="mobile" placeholder="Mobile" nolabel="1" style="width: 100%%"/>
                                    </div>
                                </div>
                                <group>
                                    <group>
                                        <field name="family_business"/>
                                        <field name="nbr" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="family_income"/>
                                    </group>
                                </group>
                            </page>
                            <page name="official_detail" string="Detalle Oficialidad">
                                <group>
                                   <group>
                                        <field name="admission_status"/>
                                        <field name="special_needs"/>
                                        <field name="academic_background"/>
                                    </group>

                                    <group>
                                        <field name="generation"/>
                                        <field name="period_4month"/>
                                    </group>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>



        <record id="op_admission_search" model="ir.ui.view">
            <field name="name">op.admission.search</field>
            <field name="model">op.admission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Registration">
                    <field name="name"/>
                    <field name="application_number"/>
                    <field name="admission_date"/>
                    <field name="application_date"/>
                    <field name="birth_date"/>
                    <field name="course_id"/>
                    <field name="batch_id"/>
                    <field name="state" />
                    <field name="admission_status"/>
                    <newline/>
                    <filter name="enrolled_student" string="Enrolled" domain="[('state','=','done')]"/>
                    <group expand="0" string="Group By...">
                        <filter string="Admission Date" name="group_by_adm_admission_date"
                                domain="[]" context="{'group_by':'admission_date'}"/>
                        <filter string="Application Date" name="group_by_adm_application_date"
                                domain="[]" context="{'group_by':'application_date'}"/>
                        <filter string="Course" name="group_by_adm_course_id"
                                domain="[]" context="{'group_by':'course_id'}"/>
                        <filter string="Batch" name="group_by_adm_batch_id"
                                domain="[]" context="{'group_by':'batch_id'}"/>
                        <filter string="Status" name="group_by_adm_state"
                                domain="[]" context="{'group_by':'state'}"/>
                        <filter string="Register" name="group_by_adm_register"
                                domain="[('register_id.state', 'not in', ['cancel', 'done'])]"
                                context="{'group_by':'register_id'}"/>
                        <filter string="Con oficialidad" name="course_sepyc_program" domain="[('course_sepyc_program', '=', True)]"/>
                        <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    </group>

                <searchpanel>
                        <field name="course_id" icon="fa fa-book" enable_counters="1"/>
                        <field name="batch_id" string="Grupo" icon="fa fa-users" enable_counters="1"/>
                </searchpanel>
                </search>
             </field>
        </record>


        <record id="op_admission_search_gen" model="ir.ui.view">
            <field name="name">op.admission.search.gen</field>
            <field name="model">op.admission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Registration">
                    <field name="name"/>
                    <field name="application_number"/>
                    <field name="admission_date"/>
                    <field name="application_date"/>
                    <field name="birth_date"/>
                    <field name="course_id"/>
                    <field name="batch_id"/>
                    <field name="state" />
                    <field name="admission_status"/>
                    <newline/>
                    <filter name="enrolled_student" string="Enrolled" domain="[('state','=','done')]"/>
                    <group expand="0" string="Group By...">
                        <filter string="Admission Date" name="group_by_adm_admission_date"
                                domain="[]" context="{'group_by':'admission_date'}"/>
                        <filter string="Application Date" name="group_by_adm_application_date"
                                domain="[]" context="{'group_by':'application_date'}"/>
                        <filter string="Course" name="group_by_adm_course_id"
                                domain="[]" context="{'group_by':'course_id'}"/>
                        <filter string="Batch" name="group_by_adm_batch_id"
                                domain="[]" context="{'group_by':'batch_id'}"/>
                        <filter string="Status" name="group_by_adm_state"
                                domain="[]" context="{'group_by':'state'}"/>
                        <filter string="Register" name="group_by_adm_register"
                                domain="[('register_id.state', 'not in', ['cancel', 'done'])]"
                                context="{'group_by':'register_id'}"/>
                        <filter string="Con oficialidad" name="course_sepyc_program" domain="[('course_sepyc_program', '=', True)]"/>
                        <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    </group>

                <searchpanel>
                        <field name="batch_id" string="Grupo" icon="fa fa-users" enable_counters="1"/>
                        <field name="course_id" icon="fa fa-book" enable_counters="1"/>
                </searchpanel>
                </search>
             </field>
        </record>





    <!-- Action Window -->
    <record id="academic_management_action" model="ir.actions.act_window">
        <field name="name">Estudiantes Inscritos</field>
        <field name="res_model">op.admission</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="op_admission_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.actions.act_window.view" id="open_op_admission_view_tree">
            <field name="act_window_id" ref="academic_management_action"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="op_admission_tree"/>
    </record>

    <record model="ir.actions.act_window.view" id="open_op_admission_view_form">
            <field name="act_window_id" ref="academic_management_action"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="op_admission_form"/>
    </record>

    <!-- Action Window Generation-->
    <record id="academic_management_action_gen" model="ir.actions.act_window">
        <field name="name">Generaciones y Lotes</field>
        <field name="res_model">op.admission</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="op_admission_search_gen"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.actions.act_window.view" id="open_op_admission_view_tree_gen">
            <field name="act_window_id" ref="academic_management_action_gen"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="op_admission_tree_gen"/>
    </record>

    <record model="ir.actions.act_window.view" id="open_op_admission_view_form_gen">
            <field name="act_window_id" ref="academic_management_action_gen"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="op_admission_form"/>
    </record>


    <!-- Menu Item -->
    <menuitem id="menu_root" name="Control Escolar" web_icon="isep_academic_management,static/description/icon.png" sequence="10"/>
    <menuitem id="menu_enrolled_students" name="Estudiantes Inscritos" parent="menu_root" action="academic_management_action" sequence="20"/>
    <menuitem id="menu_generations_lots" name="Generaciones y Lotes" parent="menu_root" action="academic_management_action_gen" sequence="30"/>
    <menuitem id="menu_payment_status" name="Estatus de Pago" parent="menu_root" action="academic_management_action" sequence="40"/>
    <menuitem id="menu_certification" name="Certificación SEP" parent="menu_root" action="academic_management_action" sequence="50"/>
    <menuitem id="menu_reports" name="Informes" parent="menu_root" sequence="60"/>

</odoo>

