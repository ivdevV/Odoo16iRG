<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View slide.slide form -->
    <record id="view_slide_field_text_slide_form" model="ir.ui.view">
        <field name="name">view.slide.slide.form</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="isep_content_interactive.view_slide_slide_form_inh"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='html_embed_code']" position="after">
                <field name="html_code_text"/>
            </xpath>
        </field>
    </record>

</odoo>