<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="paperformat_cert_diploma" model="report.paperformat">
	    <field name="name">Letter Cert Diploma</field>
	    <field name="margin_top">0</field>     <!-- No top margin -->
	    <field name="margin_bottom">0</field>  <!-- No bottom margin -->
	    <field name="margin_left">0</field>    <!-- No left margin -->
	    <field name="margin_right">0</field>   <!-- No right margin -->
	    <field name="header_line" eval="False"/>  <!-- No header line -->
	    <field name="header_spacing">0</field>    <!-- No header spacing -->
	    <field name="dpi">90</field>  <!-- DPI settings can be adjusted if needed -->
	    <field name="orientation">Portrait</field>  <!-- Portrait orientation -->
	    <field name="format">Letter</field>
	    <field name="default" eval="True"/>
        </record>

        <!-- QWeb Reports -->
        <record id="r_cert_diploma" model="ir.actions.report">
            <field name="name">Diploma Certificado</field>
            <field name="model">op.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">isep_openeducat_reports.t_cert_diploma</field>
            <field name="report_file">isep_openeducat_reports.t_cert_diploma</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="isep_openeducat_reports.paperformat_cert_diploma"/>
            <field name="attachment">(object.name or 'CERT').replace('/','_')+'.pdf'</field>
        </record>

        <template id="t_cert_diploma">
                       <t t-set="students" t-value="docs or env[doc_model].sudo().browse(student_ids)"/>
		       <t t-foreach="students" t-as="o">
			   <t t-call="isep_openeducat_reports.t_cert_diploma_document" t-lang="o.partner_id.lang"/>
		       </t>
        </template>


        <template id="t_cert_diploma_document">

            <t t-call="web.basic_layout">
                       <t t-set="libreta" t-value="env['app.gradebook.student'].sudo().search([('student_id','=',o.id),('batch_id','=',batch_id)])"/>
                       <t t-set="admission" t-value="libreta.admission_id"/>
                       <t t-set="materias" t-value="libreta.gradebook_subject_ids"/>
                       <t t-set="materias_data" t-value="['%s-%s' %(materia.name, materia.final_subject_note) for materia in libreta.gradebook_subject_ids.filtered(lambda r: r.op_subject_id.subject_type == 'compulsory')]"/>
                      <t t-if="o and libreta and admission and materias">
                       <t t-set="data_to_stamp" t-value="{'Fecha':today_string,'Estudiante':o.display_name,'Documento':'Certificado de Notas', 'Carrera':admission.course_id.display_name, 'Libreta':libreta.display_name, 'Admision':admission.display_name, 'materias':materias_data}"/>
                       <t t-set="dict_stamp" t-value="env['op.sign_certificate'].sudo().stamp_data(data_to_stamp, o)"/>

                       <div class="watermark" style="position: absolute; opacity:1.0; width:100%; height:100%; text-align:center; z-index:-1; margin: 0px; ">

                            <img class="border border-light" style="margin: 0px !important; width: 100%;" t-att-src="'/isep_openeducat_reports/static/src/img/background.png'"/>  
                         </div> 


                        <div class="page" style="min-height: 1282px; width:100%; height: auto; padding-left: 50px; padding-right: 100px;"> 

                                <div class="row" style="text-align:justify; padding-top:250px;">     
					<div class="col-12">
					    <p style='font-size:30px;color:#002E5D;'><strong>Certificado de Notas</strong></p>
					    <p style='font-size:20px;'><strong>El Departamento de Secretaría Académica Universidad ISEP</strong></p>
					    <p style='color:#ee7401;font-size:20px;'><strong>CERTIFICA:</strong></p>
					    <p style='font-size:20px;'>
						Que <span t-out="o.name"/> con número de matrícula <span t-out="admission.application_number"/>, matriculada en
						<strong t-out="admission.course_id.display_name"/> durante el periodo académico <span t-out="admission.register_id.display_name"/>, con
						una carga lectiva que consta de <span t-out="libreta.batch_id.credits"/> créditos, equivalentes a <span t-out="libreta.batch_id.hours"/> horas, ha obtenido las calificaciones
					       siguientes: 
					    </p>
					</div>
                                </div>
                              
					    <t t-set="materias_t" t-value="materias.filtered(lambda r: r.op_subject_id.subject_type == 'compulsory')"/>
					    <t t-set="materias_p1" t-value="[m for m in materias_t[:5]]"/>
					    <t t-set="materias_p2" t-value="[m for m in materias_t[5:]]"/>
				    <table class="table table-borderless table-striped mt-1 p-0" style="font-size:20px;">
					<thead>
						<tr>
						    <td><strong>Asignatura</strong></td>
						    <td><strong>Calificación</strong></td>
						</tr>
						
					</thead>
					<tbody>
					    <t t-foreach="materias_p1" t-as="m">
						<tr>
						    <td><strong t-out="m.name"/></td>
						    <td><strong t-out="m.final_subject_note"/></td>
						</tr>
					    </t>

					</tbody>
				    </table>
                                 <t t-if ="len(materias_p2) &lt;= 0">
			<div class="row mt-4" style="text-align:justify;">
                                    <div class="col-12">
					    <p style='font-size:20px;'>
					    Los créditos se ajustan al Sistema Educativo Mexicano y a los planes de estudio de Universidad ISEP.</p>
					    <p style='font-size:20px;'>
					    Para que así conste, firma el presente certificado a <span t-out="today_string"/></p>
                                    </div>
                                </div>
                    <div class="row" style="text-align:center; font-size:16px;margin-left:1em;margin-right:1em; padding-top: 50px;">
                                   <div class="col-4">
	<img alt="Barcode" style="position: relative; left: -25px;" t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=180&amp;height=180' % quote_plus('%s/verificar_documento?'%(base_url) + keep_query(stamp=dict_stamp.get('stamp',''), certificate_id = dict_stamp.get('certificate_id', 0), data_str = dict_stamp.get('data_str', '')))"/>
          
                                </div>
                                    <div class="col-8">

                                        <img src="/isep_openeducat_reports/static/src/img/firma_isep.png" style="width:132px; height:81px;"/> 
                                        <img src="/isep_openeducat_reports/static/src/img/sello_isep.png" style="width:82px; height:48px;"/> 

                                        <br></br>
                                        <strong style="color:#ee7401;">Departamento de Secretaría Académica</strong>
                                        <br></br>
                                        <p style="color:#002E5D;text-align:center;">Universidad ISEP</p>
                                    </div>
                                </div>
                                </t> <!-- fin de if not materias p2 -->
                                    
                          </div>  <!-- fin de page-->
                          <t t-if="len(materias_p2) &gt; 0">
                          <div class="watermark border border-light" style="position:absolute; opacity:1.0; width:100%; height:100%;text-align:center;z-index:-1;">

                            <img style="width: 100%;" t-att-src="'/isep_openeducat_reports/static/src/img/background.png'"/>  
                         </div>  
                        <div class="page" style="width:100%; height:100%; padding-left: 50px; padding-right: 100px;">
                            <div class="row" style="padding-top:200px;"/>
                                <table class="table table-borderless table-striped mt-1 p-0" style="font-size:20px;">
					<thead>
						<tr>
						    <td><strong>Asignatura</strong></td>
						    <td><strong>Calificación</strong></td>
						</tr>
						
					</thead>
					<tbody>
					    <t t-foreach="materias_p2" t-as="m">
						<tr>
						    <td><strong t-out="m.name"/></td>
						    <td><strong t-out="m.final_subject_note"/></td>
						</tr>
					    </t>

					</tbody>
				    </table>

                             <!-- <div class="row mt-4" style="text-align:justify; padding-top: 250px;"> -->
                             <div class="row mt-4" style="text-align:justify;">
                                    <div class="col-12">
					    <p style='font-size:20px;'>
					    Los créditos se ajustan al Sistema Educativo Mexicano y a los planes de estudio de Universidad ISEP.</p>
					    <p style='font-size:20px;'>
					    Para que así conste, firma el presente certificado a <span t-out="today_string"/></p>
                                    </div>
                                </div>
                    <div class="row" style="text-align:center; font-size:16px;margin-left:1em;margin-right:1em; padding-top: 50px; page-break-before: allways;">
                                   <div class="col-4">
	<img alt="Barcode" style="position: relative; left: -25px;" t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=180&amp;height=180' % quote_plus('%s/verificar_documento?'%(base_url) + keep_query(stamp=dict_stamp.get('stamp',''), certificate_id = dict_stamp.get('certificate_id', 0), data_str = dict_stamp.get('data_str', '')))"/>
          
                                </div>
                                    <div class="col-8">

                                        <img src="/isep_openeducat_reports/static/src/img/firma_isep.png" style="width:132px; height:81px;"/> 
                                        <img src="/isep_openeducat_reports/static/src/img/sello_isep.png" style="width:82px; height:48px;"/> 

                                        <br></br>
                                        <strong style="color:#ee7401;">Departamento de Secretaría Académica</strong>
                                        <br></br>
                                        <p style="color:#002E5D;text-align:center;">Universidad ISEP</p>
                                    </div>
                                </div>

                          </div>  <!-- fin de page2-->
                          </t> <!--fin de materias2 -->

             </t> <!--  Fin de if libreta ... -->
             </t>
        </template>
    </data>
</odoo>
