<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_order_detail" name="Portal Order Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Detalle de Orden</t>
            </t>
            
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4>Orden: <t t-esc="order.name"/></h4>
                                <p class="mb-0">Estado: <span class="badge badge-info"><t t-esc="order.state"/></span></p>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h5>Información de la Orden</h5>
                                        <p><strong>Fecha:</strong> <t t-esc="order.date_order.strftime('%d/%m/%Y')"/></p>
                                        <p><strong>Total:</strong> <t t-esc="order.amount_total"/> <t t-esc="order.currency_id.symbol"/></p>
                                        <p><strong>Número de Cuotas:</strong> <t t-esc="order.term_number"/></p>
                                        <p><strong>Fecha de Fin:</strong> <t t-esc="order.end_date.strftime('%d/%m/%Y') if order.end_date else 'N/A'"/></p>
                                    </div>
                                    <div class="col-md-6">
                                        <h5>Productos</h5>
                                        <t t-foreach="order.order_line" t-as="line">
                                            <p><t t-esc="line.product_id.name"/> - <t t-esc="line.price_total"/> <t t-esc="order.currency_id.symbol"/></p>
                                        </t>
                                    </div>
                                </div>
                                
                                <t t-if="order.subscription_schedule">
                                    <hr/>
                                    <h5>Cronograma de Pagos</h5>
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Cuota</th>
                                                    <th>Fecha Vencimiento</th>
                                                    <th>Monto</th>
                                                    <th>Estado</th>
                                                    <th>Facturas</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="order.subscription_schedule" t-as="schedule">
                                                    <tr>
                                                        <td><t t-esc="schedule.term_label"/></td>
                                                        <td><t t-esc="schedule.date_due.strftime('%d/%m/%Y')"/></td>
                                                        <td><t t-esc="schedule.amount_recurring_taxinc"/> <t t-esc="order.currency_id.symbol"/></td>
                                                        <td>
                                                            <span t-if="schedule.payment_state == 'paid'" class="badge badge-success">Pagado</span>
                                                            <span t-elif="schedule.payment_state == 'partial'" class="badge badge-warning">Parcial</span>
                                                            <span t-else="" class="badge badge-danger">Pendiente</span>
                                                        </td>
                                                        <td>
                                                            <t t-if="schedule.invoice_ids">
                                                                <t t-foreach="schedule.invoice_ids" t-as="invoice">
                                                                    <a t-att-href="'/my/invoices/%s' % invoice.id" class="btn btn-sm btn-outline-primary">
                                                                        <t t-esc="invoice.name"/>
                                                                    </a>
                                                                </t>
                                                            </t>
                                                            <span t-else="" class="text-muted">Sin factura</span>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                                
                                <div class="mt-3">
                                    <a href="/my/p_other_services" class="btn btn-secondary">Volver a Servicios</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>