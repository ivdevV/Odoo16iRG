<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View res.config.settings form -->
    <record id="view_res_config_url_settings_form" model="ir.ui.view">
        <field name="name">view.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='default_taxes_setting_container']" position="after">
                <h2>Carga</h2>
                <div class="row mt16 o_settings_container" name="upload_setting_container">
                    <div class="o_setting_left_panel">
                        <group>
                            <field name="upload_url" />
                            <field name="ocr_raw_url" />
                        </group>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>