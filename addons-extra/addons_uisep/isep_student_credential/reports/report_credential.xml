<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="paperformat_credential_card" model="report.paperformat">
            <field name="name">Credenciales Card</field>
            <field name="format">custom</field>
            <field name="page_height">70</field>
            <field name="page_width">100</field>
            <field name="orientation"></field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="dpi">90</field>   
        </record>

        <record id="r_credential" model="ir.actions.report">
            <field name="name">Credencial</field>
            <field name="model">op.admission</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">isep_student_credential.t_credential</field>
            <field name="report_file">isep_student_credential.t_credential</field>
            <field name="binding_model_id" eval="False"/> 
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="isep_student_credential.paperformat_credential_card"/>
            <field name="attachment">(object.name or 'Credencial').replace('/','_')+'.pdf'</field>
        </record>

        <template id="t_credential">
                <t t-set="admissions" t-value="docs"/>
                <t t-foreach="admissions" t-as="o">
                    <t t-call="isep_student_credential.t_credential_document" t-lang="o.partner_id.lang"/>
                </t>
        </template>


        <template id="t_credential_document">
            <t t-call="web.basic_layout">

                <t t-set="base_url" t-value="request.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
                <div class="page" style="page-break-after: always;">
                    <div class="card text-bg-dark">
                        <div class="watermark" style="position: absolute; opacity:1.0; width:100%; height:100%; text-align:center; z-index:-1; margin: 0px; top:22px ">
                            <img t-att-src="'/isep_student_credential/static/src/img/background_front.png'" alt="..." class="border border-light" style="margin: 0px !important; width: 100%;"/>
                        </div>
                        
                            <div class="card-img-overlay">
                                <div style="position: absolute; top: 40px; right: 21px; width: 80px; height: 80px; border-radius: 50%; border: 2px solid white; overflow: hidden;">
                                    <div style="width: 100%; height: 100%;">
                                        <!-- <img t-att-src="'/isep_student_credential/static/src/img/user.png'" alt="Avatar" style="width: 100%; height: 100%; border-radius: 50%; border: 2px solid white; object-fit: cover; display: block;"/> -->
                                            <img t-if="o.partner_id.image_1920" t-att-src="'/web/image/res.partner/%s/image_1920' % o.partner_id.id" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block;"/>


                                            <img t-if="not o.partner_id.image_1920" t-att-src="'/isep_student_credential/static/src/img/user.png'" alt="Avatar" style="width: 100%; height: 100%; border-radius: 50%; border: 2px solid white; object-fit: cover; display: block;"/>
                                    </div>
                                </div>

                                <div style="padding-top: 110px;">
                                    <p style="font-size: 12px; font-weight: bold; margin: 0;">NOMBRE: <span t-out="o.partner_id.name"/></p>
                                    <!-- <p style="font-size: 10px; font-weight: bold; margin: 0;">N. MATRÍCULA: <span t-out="o.application_number"/></p>
                                    <p style="font-size: 10px; font-weight: bold; margin: 0;"><span t-out="o.course_id.name"/></p> -->
                                    <p style="font-size: 12px; font-weight: bold; margin: 0;">
                                        VIGENCIA: 
                                        <t t-if="o.due_date">
                                            <span t-out="o.due_date.strftime('%Y')"/>
                                        </t>    
                                        <t t-else="">
                                            <span>-</span>
                                        </t>
                                    </p><br/><br/>
                                    <p style="font-size: 12px; font-weight: bold; margin: 0;">Alumno Universidad ISEP</p>
                                </div>

                            </div>
                    </div>

                </div>

                <div class="page" style="page-break-after: always;">
                    <div class="card text-bg-dark">
                        <div class="watermark" style="position: absolute; opacity:1.0; width:100%; height:100%; text-align:center; z-index:-1; margin: 0px; top:22px ">
                            <img t-att-src="'/isep_student_credential/static/src/img/background_back.png'" alt="..." class="border border-light" style="margin: 0px !important; width: 100%;"/>
                        </div>

                            <div class="card-img-overlay">
                                <div style="padding-top: 30px;">
                                    <p style="font-size: 10px; font-weight: bold; margin: 0;">Esta credencial es de uso exclusivo para la identificación del 
                                        estudiante ante la Universidad Isep </p>
                                </div>
                                <div style="padding-top: 18px; text-align: center;">
                                  <img alt="QR" style="width: 80px; height: 90px;" t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=180&amp;height=180' % quote_plus(base_url + '/credential/view/' + o.application_number)"/>
                                </div>
                                <div style="padding-top: 18px;">
                                    <p style="font-size: 10px; font-weight: bold; margin: 0;">Válida durante el periodo escolar vigente.</p>
                                </div>
                            </div>

                    </div>
                </div>
                
            </t>

        </template>
    </data>
</odoo>
