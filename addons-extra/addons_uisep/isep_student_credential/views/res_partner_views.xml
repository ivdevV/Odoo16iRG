<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View ir.attachment form -->
    <record id="view_res_partner_use_profile_form" model="ir.ui.view">
        <field name="name">view.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="isep_record_request.res_partner_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_accept']" position="after">
                <field name="is_image" invisible="1"/>
                <button name="use_profile_picture" 
                    type="object" 
                    string="Usar para perfil" 
                    class="btn-warning"
                     attrs="{'invisible': [('is_image','=',False)]}"
                    />
            </xpath>
        </field>
    </record>

</odoo>