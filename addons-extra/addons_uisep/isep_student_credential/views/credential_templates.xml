<odoo>
    <template id="student_info_template" name="Student Info Page">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h2>Estudiante Isep</h2>
                <ul>
                    <li><strong>Nombre:</strong> <t t-esc="student.partner_id.name"/></li>
                    <li><strong>Vigencia:</strong> <t t-esc="student.due_date"/></li>
                </ul>
            </div>
        </t>
    </template>

    <template id="student_not_found_template" name="Credential Not Found">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h3>No se encontró un estudiante con el código: "<t t-esc="code"/>".</h3>
            </div>
        </t>
    </template>

    <template id="student_expired_template" name="Credential Expired">
        <t t-call="website.layout">
            <div class="container my-5">
                <h2 class="text-danger">La credencial ya no es válida</h2>
                <p>Este documento ya ha expirado. Por favor comuníquese con administración si necesita renovarlo.</p>
            </div>
        </t>
    </template>
</odoo>
