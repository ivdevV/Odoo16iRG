<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="isep_slide_content_code_replace" inherit_id="isep_survey.isep_slide_content_text_replace">
            <xpath expr="//div[@class='wrap o_survey_start']" position="replace">
                <div class="wrap o_survey_start">
                    <div class='mb32'>
                        <!-- Reemplazar el campo description condicionalmente -->
                        <t t-if="survey.use_html_embed">
                            <div class="oe_no_empty pb-5 text-break" t-raw="survey.html_embed_code"/>
                        </t>
                        <t t-else="">
                            <div t-field='survey.description' class="oe_no_empty pb-5 text-break"/>
                        </t>
                        
                        <t t-if="answer.is_session_answer">
                            <div class="fw-bold">
                                The session will begin automatically when the host starts.
                            </div>
                        </t>
                        <t t-else="">
                            <div t-if="survey.is_time_limited">
                                <p>
                                    <span t-if="not survey.certification">Time limited: </span>
                                    <span t-else="">Time limit: </span>
                                    <span class="fw-bold text-danger" t-field="survey.time_limit" t-options="{'widget': 'duration', 'unit': 'minute'}"/>
                                </p>
                            </div>
                            <button type="submit" value="start" class="btn btn-primary btn-lg">
                                <t t-if="survey.certification">
                                    Iniciar [Start]
                                </t>
                                <t t-else="">
                                    Iniciar [Start]
                                </t>
                            </button>
                            <span class="o_survey_enter fw-bold text-muted ms-2 d-none d-md-inline">or press Enter</span>
                        </t>
                    </div>
                </div>
            </xpath>
        </template>
        
    </data>
</odoo>