<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View op.admission form -->
    <record id="view_op_invoice_admission_form" model="ir.ui.view">
        <field name="name">view.op.admission.form</field>
        <field name="model">op.admission</field>
        <field name="inherit_id" ref="openeducat_admission.view_op_admission_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_detail']" position="inside">
                <group>
                    <group>
                        <field name="number_invoice_count"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>