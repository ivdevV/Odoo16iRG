<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="confirmation_subscription_custom" inherit_id="website_sale.confirmation" priority="99">
        <!-- Replace the standard warning for subscriptions -->
        <xpath expr="//div[hasclass('alert-warning')]" position="replace">
            <div class="alert alert-warning" role="alert" t-if="not order.is_subscription and (order.get_portal_last_transaction().state == 'pending' or (order.get_portal_last_transaction().state == 'done' and order.amount_total != order.get_portal_last_transaction().amount))">
                <span t-if="order.get_portal_last_transaction().state == 'pending'">Your payment has been authorized.</span>
                <span t-if="order.get_portal_last_transaction().state == 'done'">Your payment has been processed successfully but the amount paid is different from the order total. Please contact us for more information.</span>
            </div>
            
            <!-- Add a success message for subscriptions -->
            <div class="alert alert-success" role="alert" t-if="order.is_subscription and order.get_portal_last_transaction().state == 'done'">
                <span>Su suscripción se ha procesado correctamente. Se ha pagado la primera cuota.</span>
            </div>
        </xpath>
    </template>

    <template id="total_subscription_custom" inherit_id="website_sale.total" priority="99">
        <xpath expr="//tr[@id='order_total']" position="after">
            <tr id="order_total_paid" t-if="website_sale_order.is_subscription and website_sale_order.get_portal_last_transaction().state == 'done'">
                <td class="text-right"><strong>Pagado ahora:</strong></td>
                <td class="text-xl-right">
                    <strong t-field="website_sale_order.get_portal_last_transaction().amount" class="monetary_field"
                        t-options='{"widget": "monetary", "display_currency": website_sale_order.currency_id}'/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
