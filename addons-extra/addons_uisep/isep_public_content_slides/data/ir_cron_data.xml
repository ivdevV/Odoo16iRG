<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_courses_content_to_txt" model="ir.cron">
            <field name="name">Courses Content slide to txt</field>
            <field name="model_id" ref="openeducat_core.model_op_course"/>
            <field name="state">code</field>
            <field name="code">model.sync_slides_to_txt(100)</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=3, minute=0, second=0)"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>