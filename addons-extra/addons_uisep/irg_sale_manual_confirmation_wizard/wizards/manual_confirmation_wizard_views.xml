<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_manual_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">irg.manual.confirmation.wizard.form</field>
        <field name="model">irg.manual.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Validar y Confirmar Presupuesto">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="admission_date"/>
                    </group>
                    <group string="Previsualizacion">
                        <field name="modalidad_detected" readonly="1"/>
                        <field name="batch_preview" readonly="1"/>
                    </group>
                    <separator string="Avisos" attrs="{'invisible': [('warning_message', '=', False)]}"/>
                    <group col="1" attrs="{'invisible': [('warning_message', '=', False)]}" class="w-100">
                        <field name="warning_message" nolabel="1" readonly="1" class="w-100"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
