<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_manual_wizard_inh" model="ir.ui.view">
        <field name="name">sale.order.form.manual.wizard.inh</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][1]" position="before">
                <button name="action_open_manual_confirmation_wizard"
                        string="Confirmar (validar)"
                        type="object"
                        class="btn-primary"
                        states="draft,sent"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>

</odoo>
