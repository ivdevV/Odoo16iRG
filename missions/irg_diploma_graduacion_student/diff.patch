+<?xml version="1.0" encoding="utf-8"?>
+<odoo>
+    <!-- Wizard View -->
+    <record id="view_irg_diploma_graduacion_wizard_form" model="ir.ui.view">
+        <field name="name">irg.diploma.graduacion.wizard.form</field>
+        <field name="model">irg.diploma.graduacion.wizard</field>
+        <field name="arch" type="xml">
+            <form string="Generar Diploma de Graduación">
+                <group>
+                    <group>
+                        <field name="student_id" options="{'no_create': True, 'no_open': True}"/>
+                        <field name="student_course_id" options="{'no_create': True, 'no_open': True}"/>
+                        <field name="date"/>
+                    </group>
+                </group>
+                <footer>
+                    <button name="action_print_pdf" string="Generar PDF" type="object" class="btn-primary"/>
+                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
+                </footer>
+            </form>
+        </field>
+    </record>
+
+    <!-- Action to open Wizard -->
+    <record id="action_irg_diploma_graduacion_wizard" model="ir.actions.act_window">
+        <field name="name">Generar Diploma de Graduación</field>
+        <field name="type">ir.actions.act_window</field>
+        <field name="res_model">irg.diploma.graduacion.wizard</field>
+        <field name="view_mode">form</field>
+        <field name="view_id" ref="view_irg_diploma_graduacion_wizard_form"/>
+        <field name="target">new</field>
+    </record>
+</odoo>
