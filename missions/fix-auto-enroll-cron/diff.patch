+                    self.assertTrue(write_trigger_ids)
+                    owned_trigger_ids.update(write_trigger_ids)
+                    change_cr.commit()
+                if setup_trigger_ids:
+                    running_cr.execute(
+                        'DELETE FROM ir_cron_trigger WHERE id = ANY(%s)',
+                        [list(setup_trigger_ids)],
