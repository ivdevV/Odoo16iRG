+            batch = setup_env['op.batch'].create({
+                'name': 'Concurrent trigger batch %s' % suffix,
+                'code': 'TRIGGER-%s' % suffix,
+                'course_id': course.id,
+                'start_date': date.today() - timedelta(days=30),
+                'end_date': date.today() + timedelta(days=30),
+            })
+            line = batch.subject_to_batch_ids[:1]
