+<?xml version="1.0" encoding="utf-8"?>
+<odoo>
+    <record id="view_oficialidad_send_wizard_form" model="ir.ui.view">
+        <field name="name">oficialidad.send.wizard.form</field>
+        <field name="model">oficialidad.send.wizard</field>
+        <field name="arch" type="xml">
+            <form string="Enviar oficialidad">
+                <group>
+                    <field name="register_id" readonly="1"/>
+                </group>
+                <field name="admission_ids"
+                       domain="[('register_id', '=', register_id)]"
+                       options="{'no_create': True, 'no_create_edit': True}">
+                    <tree editable="bottom" delete="1">
+                        <field name="application_number" readonly="1"/>
+                        <field name="name" readonly="1"/>
+                        <field name="state" readonly="1"/>
+                        <field name="oficialidad_sent_date" readonly="1"/>
+                    </tree>
+                </field>
+                <footer>
+                    <button name="action_send" string="Enviar" type="object"
+                            class="btn-primary"
+                            groups="openeducat_admission.group_op_admission_admin"/>
+                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
+                </footer>
+            </form>
+        </field>
+    </record>
+
+    <record id="action_oficialidad_send_wizard" model="ir.actions.act_window">
+        <field name="name">Enviar oficialidad</field>
+        <field name="res_model">oficialidad.send.wizard</field>
+        <field name="view_mode">form</field>
+        <field name="target">new</field>
+        <field name="groups_id"
+               eval="[(6, 0, [ref('openeducat_admission.group_op_admission_admin')])]"/>
+    </record>
+</odoo>
