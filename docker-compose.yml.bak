services:
    odoo_latest:
        container_name: odoo_latest
          #1image: 6bea8fb7223c
        image: 698f15fc040a
          #odoo:16.0-20240924
        restart: unless-stopped
        volumes:
            - ./addons-extra:/mnt/extra-addons
            - ./etc/odoo:/etc/odoo
            - /mnt/dbfilestore/filestore/_data:/var/lib/odoo
            - ./log:/var/log/odoo
              #ports:
              #- "8069:8069"
        depends_on:
          - pgodoo_latest
            #networks:
            #- odoo_default
        logging:
          driver: "json-file"
          options:
            max-size: "2000m"
            max-file: "5"
        extra_hosts:
          - "services.openerp.com:127.0.0.1" #host and ip
          - "odoo.com:127.0.0.1"
        build:
          context: ./odoo


    pgodoo_latest:
        container_name: pgodoo_latest
        image: postgres:16
        restart: unless-stopped
        environment:
            - POSTGRES_DB=postgres
            - POSTGRES_PASSWORD=!ridridR@+#cra8o@rac
            - POSTGRES_USER=odoo
            - PGDATA=/var/lib/postgresql/data/pgdata
        volumes:
            - /mnt/dbfilestore/database/_data:/var/lib/postgresql/data/pgdata
            - ./db/backups:/backups
        ports:
            - "58432:5432"
              #- ./etc/postgresql/postgresql.conf:/var/lib/postgresql/data/pgdata/postgresql.conf
              #networks:
              #- odoo_default
        logging:
          driver: "json-file"
          options:
            max-size: "2000m"
            max-file: "5"
            #volumes:
            #odoo_latest-web-data:
            #    odoo_latest-db-data:
    nginx:
        container_name: nginx
        image: nginx:latest
        restart: unless-stopped
        ports:
            - 80:80
            - 443:443
        volumes:
            - ./nginx/nginx.conf:/etc/nginx/nginx.conf
            - ./certbot/conf:/etc/nginx/ssl
            - ./certbot/data:/var/www/html
    redisodoo:
      container_name: redisodoo
      image: redis:latest
      volumes:
        - /mnt/dbfilestore/redisodoo:/data
      expose:
        - 6379
          #networks:
          # - odoo_default
      restart: always

    certbot:
        container_name: certbot
        image: certbot/certbot:latest
        entrypoint: ""
        command: sh -c "certbot certonly --webroot --webroot-path=/var/www/html --email desarrollo@fantasticolab.com --agree-tos --no-eff-email -d app.institutoraimongaja.com --keep && certbot certonly --webroot --webroot-path=/var/www/html --email desarrollo@fantasticolab.com --agree-tos --no-eff-email -d 16nativoirg.fantasticolab.com --keep && certbot certonly --webroot --webroot-path=/var/www/html --email desarrollo@fantasticolab.com --agree-tos --no-eff-email -d erp.laramieuniversity.com --keep"
        volumes:
            - ./certbot/conf:/etc/letsencrypt:rw
            - ./certbot/logs:/var/log/letsencrypt:rw
            - ./certbot/data:/var/www/html:rw

